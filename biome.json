{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/generated",
      "!**/.expo",
      "!**/node_modules",
      "!**/*.gen.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "linter": { "rules": { "preset": "recommended", "style": { "useImportType": "off" } } }
}
