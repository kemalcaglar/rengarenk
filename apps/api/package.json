{
  "name": "@rengarenk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:iade": "node --watch --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/refund-executor.ts",
    "start:iade": "node dist/refund-executor.js",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run",
    "sahip": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli/sahip.ts",
    "yasal:yukle": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli/yasal-yukle.ts",
    "katalog:anahtar": "node --import @swc-node/register/esm-register src/cli/katalog-anahtar.ts",
    "katalog:yukle": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli/katalog-yukle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.879.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-fastify": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@rengarenk/catalog": "workspace:*",
    "@rengarenk/db": "workspace:*",
    "@rengarenk/shared": "workspace:*",
    "@sentry/node": "11.11.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg-boss": "12.38.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.16.22",
    "@types/node": "22.19.17",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
