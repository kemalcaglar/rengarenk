{
  "expo": {
    "name": "Rengarenk",
    "slug": "rengarenksite",
    "owner": "www.rengarenksite.com",
    "scheme": "rengarenk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.rengarenksite.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.rengarenksite.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kurumsal başvuru belgelerini ve araç fotoğraflarını çekmek için kamerana erişmemiz gerekiyor.",
          "photosPermission": "Kurumsal başvuru belgelerini ve araç fotoğraflarını seçmek için fotoğraflarına erişmemiz gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8fb8249a-e7f4-486b-8ef9-ffd2c6bc7137"
      }
    }
  }
}
