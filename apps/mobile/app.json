{
  "expo": {
    "name": "Rengarenk",
    "slug": "rengarenk",
    "scheme": "rengarenk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "tr.com.rengarenk.app",
      "supportsTablet": false
    },
    "android": {
      "package": "tr.com.rengarenk.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kurumsal başvuru belgelerini ve araç fotoğraflarını çekmek için kamerana erişmemiz gerekiyor.",
          "photosPermission": "Kurumsal başvuru belgelerini ve araç fotoğraflarını seçmek için fotoğraflarına erişmemiz gerekiyor.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
