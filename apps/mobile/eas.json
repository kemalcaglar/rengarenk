{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.16.0",
      "pnpm": "10.28.0"
    },
    "test": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rengarenksite.com",
        "EXPO_PUBLIC_WEB_URL": "https://beta.rengarenksite.com"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rengarenksite.com",
        "EXPO_PUBLIC_WEB_URL": "https://rengarenksite.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
