# Yerel geliştirme. Kopyala: cp .env.example .env
NODE_ENV=development
DATABASE_URL=postgresql://rengarenk:rengarenk@localhost:5433/rengarenk
TEST_DATABASE_URL=postgresql://rengarenk:rengarenk@localhost:5433/rengarenk_test
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=rengarenk
S3_SECRET_KEY=rengarenk-dev-secret
S3_BUCKET=rengarenk
SMTP_URL=smtp://localhost:1025
# En az 32 karakter; canlıda SOPS ile şifreli dosyadan gelir
JWT_SECRET=gelistirme-icin-en-az-32-karakterlik-gizli-anahtar
# console: kodlar API günlüğüne yazılır (yalnızca geliştirme)
SMS_PROVIDER=console
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
