# Yerel geliştirme. Kopyala: cp .env.example .env
NODE_ENV=development
DATABASE_URL=postgresql://rengarenk:rengarenk@localhost:5433/rengarenk
TEST_DATABASE_URL=postgresql://rengarenk:rengarenk@localhost:5433/rengarenk_test
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
# Galeri başvurusu kontrolleri: yerelde sahte (fake), canlıda bağlantı gelene kadar none
GALLERY_VERIFY_PROVIDER=fake
# EİDS (portföy aracı ilan onayı): yerelde sahte, canlıda bağlantı gelene kadar none
EIDS_PROVIDER=fake
# Web ödemesi ve e-Arşiv: geliştirmede sahte sağlayıcı (canlıda paytr ve gerçek entegratör)
PAYMENT_PROVIDER=fake
EARSIV_PROVIDER=fake
# Mağaza ödemeleri (Karar 38): geliştirmede sahte mağaza
STORE_PROVIDER=fake
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=rengarenk
S3_SECRET_KEY=rengarenk-dev-secret
S3_BUCKET=rengarenk
SMTP_URL=smtp://localhost:1025
# En az 32 karakter; canlıda SOPS ile şifreli dosyadan gelir
JWT_SECRET=gelistirme-icin-en-az-32-karakterlik-gizli-anahtar
# console: kodlar API günlüğüne yazılır (yalnızca geliştirme)
SMS_PROVIDER=console
# Ana sağlayıcı arızalanırsa kullanılacak yedek (boş bırakılabilir)
SMS_FALLBACK_PROVIDER=
SMS_SENDER_ID=RENGARENK
ILETIMERKEZI_KEY=
ILETIMERKEZI_HASH=
LOG_LEVEL=info
# Boşsa /metrics geliştirmede açıktır; canlıda zorunlu
METRICS_TOKEN=
# GlitchTip adresi; boşsa hata izleme kapalı
SENTRY_DSN=
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
# Yönetim girişi (T10). fake: Google hesabı açılana kadar sahte Google sayfası (yalnızca geliştirme)
STAFF_AUTH_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_EMAIL_DOMAINS=rengarenk.com.tr
# Yalnızca geliştirme: false yapılırsa kişisel Google hesabıyla gerçek giriş denenebilir (canlıda yasak)
STAFF_REQUIRE_WORKSPACE=true
# pnpm db:seed ile açılan yerel Sahip hesabı (alanı STAFF_EMAIL_DOMAINS içinde olmalı)
SEED_OWNER_EMAIL=sahip@rengarenk.com.tr
SEED_OWNER_NAME=
# Katalog paketi imza anahtarları (Ed25519). Boşsa geliştirmede JWT_SECRET'ten türetilir; canlıda zorunlu
CATALOG_SIGNING_KEY=
CATALOG_VERIFY_KEY=
# Boşsa geliştirmede JWT_SECRET'ten türetilir; canlıda zorunlu (en az 32 karakter)
STAFF_SECRET_KEY=
# Mesaj gövdelerini şifreler (en az 32 karakter); boşsa geliştirmede JWT_SECRET'ten türetilir
MESSAGE_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web sunucusunun API'ye gideceği adres (canlıda iç ağ adresi)
API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
