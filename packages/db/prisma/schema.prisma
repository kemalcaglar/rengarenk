// Rengarenk veri modeli · Sprint 1 kapsamı
// Kişisel veri içeren alanlar `/// @pii` ile etiketlenir (Teknik tasarım §4). Maskeleme,
// veri kopyası, anonimleştirme ve imha bu etiketlerden çalışır.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Kimlik ve hesap ────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountKind {
  INDIVIDUAL
  BUSINESS
}

enum BusinessKind {
  DEALER
  RENTAL
  BOAT
  AIRCRAFT
}

enum AccountStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  MANAGER
  SALES
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model User {
  id              String     @id @db.Uuid
  /// @pii E.164 biçiminde, ör. +905321234567
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// @pii
  displayName     String?    @map("display_name")
  /// @pii Ad (Karar 29: talepte tam ad ya da "Ayşe Y." gösterimi için ayrı tutulur)
  firstName       String?    @map("first_name")
  /// @pii Soyad
  lastName        String?    @map("last_name")
  /// @pii
  email           String?
  /// E-posta doğrulandıysa zamanı (bildirim e-postası yalnızca doğrulanmış adrese gider)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// @pii Profildeki il ve ilçe (yeni talebin konumu bununla açılır)
  il              String?
  /// @pii
  ilce            String?
  /// İletişim tercihleri (Karar 29): yeni talepler bunlarla açılır, her talepte ayrıca değişir
  nameMode        String     @default("tam") @map("name_mode")
  phoneVisible    Boolean    @default(false) @map("phone_visible")
  whatsappVisible Boolean    @default(false) @map("whatsapp_visible")
  /// Aranabilir saatler (Türkiye saati, 0–24); dışında telefon ve WhatsApp gizli. Varsayılan 09.00–21.00
  callFrom        Int        @default(9) @map("call_from")
  callTo          Int        @default(21) @map("call_to")
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         AccountMember[]
  notifications       Notification[]
  notificationPrefs   NotificationPref[]
  pushTokens          PushToken[]
  devices             Device[]
  sessions            Session[]
  featureTester       FeatureTester?
  demands             Demand[]
  favorites           Favorite[]
  savedSearches       SavedSearch[]
  galleryApplications GalleryApplication[]
  buyerConversations  Conversation[]       @relation("alici")
  ratings             Rating[]
  orders              Order[]
  follows             GalleryFollow[]
  blocks              UserBlock[]

  @@map("users")
}

model Account {
  id           String        @id @db.Uuid
  kind         AccountKind
  name         String
  businessKind BusinessKind? @map("business_kind")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  members             AccountMember[]
  ledger              EntitlementLedger[]
  demands             Demand[]
  gallery             Gallery?
  subscription        Subscription?
  invites             AccountInvite[]
  vehicles            PortfolioVehicle[]
  apiKeys             ApiKey[]
  matches             Match[]
  sellerConversations Conversation[]      @relation("satici")
  ratingsReceived     Rating[]
  orders              Order[]
  followers           GalleryFollow[]
  sellerStats         SellerStats?
  blockedBy           UserBlock[]

  @@map("accounts")
}

model AccountMember {
  accountId         String     @map("account_id") @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  role              MemberRole
  /// Sahibin koyduğu günlük ilk mesaj sınırı (Karar 20); boşsa sınır yok
  dailyMessageLimit Int?       @map("daily_message_limit")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model Device {
  id         String         @id @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  /// @pii
  pushToken  String?        @map("push_token")
  trusted    Boolean        @default(false)
  /// @pii Uygulama kurulum kimliğinin anahtarlı özeti (cihaz kara listesi, Karar 43); kimliğin kendisi saklanmaz
  installHash String?       @map("install_hash")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@index([installHash])
  @@map("devices")
}

/// Yenileme jetonu 90 gün geçerlidir (T09). Jetonun kendisi değil, SHA-256 özeti saklanır.
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Jeton yenilenince (döndürme) true: bu jeton yeniden gelirse çalınmış sayılır ve bütün oturumlar kapanır.
  /// Elle kapatılan oturumun (Ayarlar, numara değişikliği, çalışan) jetonu yalnızca reddedilir.
  rotated          Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/**
 * Giriş bağlantısı (Karar 52): destek, kişinin doğrulanmış e-postasına tek kullanımlık giriş bağlantısı gönderir
 * (telefonuna ulaşamayan kişi web'den girip numarasını değiştirir). Bağlantının kendisi değil özeti saklanır; 15 dakika
 * geçerli, bir kez kullanılır; yenisi gönderilince eskileri geçersiz olur.
 */
model LoginLink {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  /// Gönderen çalışan
  staffId   String    @map("staff_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  /// Yenisi gönderildi ya da kişi giriş yaptı
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("login_links")
}

model OtpChallenge {
  id         String    @id @db.Uuid
  /// @pii
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// @pii
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// ── Yönetim ekibi ve yetkiler (Karar 40, T10) ────────────────

/// Hazır roller `packages/shared/src/staff.ts` içindeki matristen yetki alır.
/// CATALOG eski değerdir, atanamaz (kontrol kısıtı). CUSTOM: yetkileri `staff_roles` tablosundan gelir.
enum StaffRole {
  OWNER
  ADMIN
  MODERATOR
  SUPPORT
  CATALOG
  FINANCE
  AGENT
  OPERATIONS
  MARKETING
  VIEWER
  CUSTOM
}

enum StaffStatus {
  ACTIVE
  DISABLED
  INVITED
}

model StaffMember {
  id               String      @id @db.Uuid
  /// @pii Google Workspace şirket e-postası
  email            String      @unique
  /// @pii
  name             String
  role             StaffRole
  customRoleId     String?     @map("custom_role_id") @db.Uuid
  status           StaffStatus @default(ACTIVE)
  /// Doğrulama uygulaması kurulup ilk kodla onaylandıysa true
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  /// Doğrulama uygulaması sırrı, AES-256-GCM ile şifreli (anahtar STAFF_SECRET_KEY)
  totpSecretEnc    String?     @map("totp_secret_enc")
  /// Son kabul edilen kodun zaman adımı; aynı kod ikinci kez kullanılamaz
  totpLastStep     BigInt?     @map("totp_last_step")
  /// Google hesabının değişmez kimliği; ilk girişte bağlanır
  googleSub        String?     @unique @map("google_sub")
  invitedBy        String?     @map("invited_by") @db.Uuid
  inviteExpiresAt  DateTime?   @map("invite_expires_at") @db.Timestamptz(3)
  lastLoginAt      DateTime?   @map("last_login_at") @db.Timestamptz(3)
  disabledAt       DateTime?   @map("disabled_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customRole         StaffCustomRole?    @relation(fields: [customRoleId], references: [id])
  requestedApprovals Approval[]          @relation("ApprovalRequester")
  decidedApprovals   Approval[]          @relation("ApprovalDecider")
  sessions           StaffSession[]
  devices            StaffDevice[]
  recoveryCodes      StaffRecoveryCode[]

  @@map("staff_members")
}

/// Sahibin yetkileri tek tek işaretleyerek oluşturduğu rol. permissions: { "rapor.gor": "tam", ... }
model StaffCustomRole {
  id          String   @id @db.Uuid
  name        String   @unique
  permissions Json
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members StaffMember[]

  @@map("staff_roles")
}

/// Yönetim girişinin ara adımı: Google yönlendirmesi (state, nonce, PKCE), ardından iki adımlı doğrulama.
/// `ticketHash` yalnızca Google adımı geçince dolar; iki adımlı doğrulama bu biletle yapılır.
model StaffLoginChallenge {
  id             String    @id @db.Uuid
  stateHash      String    @unique @map("state_hash")
  nonce          String
  codeVerifier   String    @map("code_verifier")
  staffId        String?   @map("staff_id") @db.Uuid
  googleSub      String?   @map("google_sub")
  ticketHash     String?   @unique @map("ticket_hash")
  /// Kurulum sırasında üretilen, henüz onaylanmamış sır (şifreli)
  pendingTotpEnc String?   @map("pending_totp_enc")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  googleAt       DateTime? @map("google_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// @pii
  ip             String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("staff_login_challenges")
}

/// Yönetim oturumu: jetonun SHA-256 özeti saklanır. 30 dk hareketsizlikte ve en geç 12 saatte kapanır.
model StaffSession {
  id           String    @id @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// @pii
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff  StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  device StaffDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@map("staff_sessions")
}

/// Çalışanın giriş yaptığı tarayıcılar. Yeni cihazdan girişte sahibe bildirim gider (Karar 40).
model StaffDevice {
  id          String   @id @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  /// @pii
  userAgent   String?  @map("user_agent")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  staff    StaffMember    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@unique([staffId, deviceHash])
  @@map("staff_devices")
}

/// Doğrulama uygulamasına erişilemezse kullanılan tek kullanımlık kurtarma kodları (özetleri).
model StaffRecoveryCode {
  id       String    @id @db.Uuid
  staffId  String    @map("staff_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_recovery_codes")
}

enum ActorType {
  USER
  STAFF
  AGENT
  SYSTEM
}

/// Yalnızca ekleme yapılır; güncelleme ve silme veritabanı tetikleyicisiyle engellenir. 2 yıl saklanır.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  /// @pii Dönem anahtarıyla şifreli (k1.<anahtar>.<şifreli>); anahtar 2 yıl sonra silinir
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

/// İşlem kaydındaki IP adresleri dönem anahtarıyla şifrelenir (yalnızca ekleme yapılan tablo değiştirilmeden imha):
/// saklama süresi dolunca dönemin anahtarı silinir ve o dönemin IP adresleri okunamaz olur.
model PiiKey {
  /// islem-2026-2 (amaç ve yarıyıl)
  id        String   @id
  purpose   String
  /// Dönemin bitişi; saklama süresi buradan sayılır
  periodEnd DateTime @map("period_end") @db.Timestamptz(3)
  /// Ana anahtarla şifrelenmiş rastgele dönem anahtarı
  keyEnc    String   @map("key_enc")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, periodEnd])
  @@map("pii_keys")
}

// ── Olaylar ───────────────────────────────────────────────────

/// Her işlem kendi olayını aynı veritabanı işleminde buraya yazar; aktarıcı kuyruğa iletir.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("outbox")
}

// ── Haklar ────────────────────────────────────────────────────

/// Hak defteri: yalnızca ekleme. Bakiye defterden hesaplanır.
/// (source_type, source_id, kind) tekil: aynı olay iki kez işlenmez.
model EntitlementLedger {
  id         BigInt   @id @default(autoincrement())
  accountId  String   @map("account_id") @db.Uuid
  /// talep, ilk_mesaj, uzatma, ust_sira, acil, vitrin
  kind       String
  /// artı: satın alma veya tanımlama, eksi: kullanım veya iade
  delta      Int
  /// satin_alma, paket, tanimlama, kullanim, iade, sure_dolumu
  reason     String
  /// order, staff_grant, package_cycle, message, refund
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  /// kullanıcı, çalışan veya ajan
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@unique([sourceType, sourceId, kind])
  @@index([accountId, kind])
  @@map("entitlement_ledger")
}

// ── Onaylar (dört göz) ve iade kilidi ─────────────────────────

/// Onay motoru türleri; kurallar `packages/shared/src/staff.ts` (APPROVAL_POLICIES). STAFF_ROLE kullanılmıyor.
enum ApprovalKind {
  REFUND
  PRICE_CHANGE
  STAFF_ROLE
  BULK_SEND
  COUPON
  PERMANENT_BAN
  ACCOUNT_DELETE
  CATEGORY_SCHEMA
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Karara bağlanan onay değiştirilemez (rr_approval_immutable). Yürütme sonucu `approval_results` tablosundadır.
model Approval {
  id           String         @id @db.Uuid
  kind         ApprovalKind
  status       ApprovalStatus @default(PENDING)
  subjectType  String         @map("subject_type")
  subjectId    String         @map("subject_id")
  /// Kuruş cinsinden tutar (iadelerde zorunlu)
  amountKurus  BigInt?        @map("amount_kurus")
  payload      Json           @default("{}")
  /// Kuyrukta görünen kısa başlık
  title        String         @default("")
  /// İsteyenin gerekçesi
  reason       String?
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote String?        @map("decision_note")
  /// Bu tarihe kadar karar verilmezse istek düşer
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  requester StaffMember      @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  decider   StaffMember?     @relation("ApprovalDecider", fields: [decidedBy], references: [id])
  refunds   Refund[]
  results   ApprovalResult[]

  @@index([kind, status])
  @@index([status, expiresAt])
  @@map("approvals")
}

enum ApprovalOutcome {
  SUCCEEDED
  FAILED
}

/// Onaylanan işlemin yürütme denemeleri. Yalnızca ekleme; son satır güncel sonuçtur.
model ApprovalResult {
  id         BigInt          @id @default(autoincrement())
  approvalId String          @map("approval_id") @db.Uuid
  outcome    ApprovalOutcome
  detail     Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  approval Approval @relation(fields: [approvalId], references: [id])

  @@index([approvalId])
  @@map("approval_results")
}

enum RefundStatus {
  PENDING_EXECUTION
  EXECUTED
  FAILED
}

/// "Bana sorulmadan sistemde hiçbir zaman iade yapılmasın." Kilit 1: veritabanı tetikleyicisi
/// her iade kaydının Sahip rolündeki bir çalışanın 72 saatten eski olmayan onayına bağlı olduğunu
/// ve tutarın onaydakiyle aynı olduğunu denetler (migration.sql).
model Refund {
  id          String       @id @db.Uuid
  paymentId   String       @map("payment_id")
  amountKurus BigInt       @map("amount_kurus")
  approvalId  String       @unique @map("approval_id") @db.Uuid
  status      RefundStatus @default(PENDING_EXECUTION)
  executedAt  DateTime?    @map("executed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// İade edilen sipariş (ödeme bildirimi bu siparişin)
  orderId     String?      @map("order_id") @db.Uuid
  /// paytr | fake
  provider    String?
  /// Ödeme kuruluşuna giden iade referansı (PayTR reference_no)
  referenceNo String?      @map("reference_no")
  /// Başarısız ya da sonucu belirsiz iadede açıklama
  failReason  String?      @map("fail_reason")

  approval Approval       @relation(fields: [approvalId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])
  invoice  RefundInvoice?

  @@index([orderId])
  @@map("refunds")
}

/// İade faturası (e-Arşiv; Karar 12.7): iade yürütülünce kuyruğa girer, entegratör gelince kesilir. Silinmez.
model RefundInvoice {
  id        String        @id @db.Uuid
  refundId  String        @unique @map("refund_id") @db.Uuid
  provider  String
  status    InvoiceStatus @default(PENDING)
  no        String?
  pdfKey    String?       @map("pdf_key")
  attempts  Int           @default(0)
  lastError String?       @map("last_error")
  issuedAt  DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  refund Refund @relation(fields: [refundId], references: [id])

  @@map("refund_invoices")
}

// ── Ayarlar: özellik anahtarları ve bakım (T13, Karar 47) ─────

enum FlagAudience {
  ALL
  BUSINESS
  TESTERS
}

/// Anahtar listesi kodda (`packages/shared/src/flags.ts`); satırı olmayan anahtar kapalıdır.
/// Bakım alanları `bakim.tum`, `bakim.odeme` … anahtarlarıyla burada durur; `note` kullanıcıya gösterilen duyurudur.
model FeatureFlag {
  key       String           @id
  enabled   Boolean          @default(false)
  audience  FlagAudience     @default(ALL)
  /// Kitlenin yüzde kaçına açık (kullanıcı kimliğinden hesaplanan sabit dilim)
  percent   Int              @default(100)
  /// Boş: tüm platformlar
  platforms DevicePlatform[] @default([])
  note      String?
  updatedBy String?          @map("updated_by") @db.Uuid
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

/// Yeni özellikleri önce deneyen kullanıcılar (çalışanların kendi kullanıcı hesapları; Teknik tasarım §15).
model FeatureTester {
  userId    String   @id @map("user_id") @db.Uuid
  addedBy   String   @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feature_testers")
}

// ── Araç kataloğu (Aşama 2; Teknik tasarım §4–5, Karar 32–34) ─────
// Her kaydın doğal bir anahtarı vardır ("bmw", "bmw/3-serisi", "bmw/3-serisi/320i"); aylık içe aktarma bu
// anahtarlarla günceller. Kaynaktan düşen hiçbir kayıt silinmez (Karar 33). Kasko bedeli hiçbir tabloda tutulmaz.

/// Katalog veri kaynağı: TSB, açık veri setleri, Commons. Konsoldaki "Katalog kaynakları" ekranı bunu izler.
model CatalogSource {
  key           String    @id
  name          String
  license       String
  attribution   String?
  url           String?
  /// Kaynak her ay kendiliğinden çekilsin mi (sahip kararı, 7 Kasım 2026: TSB için konsoldan yükleme ve otomatik çekme birlikte)
  autoFetch     Boolean   @default(false) @map("auto_fetch")
  /// Kapalı kaynağın kayıtları katalogdan görünmez (silinmez); ör. avukat görüşü olumsuz çıkarsa (Teknik tasarım §5)
  active        Boolean   @default(true)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastVersion   String?   @map("last_version")
  /// Kaynakta görülen son dosya adı (ör. 202610R2.xlsx); aynı dosya ikinci kez işlenmez
  lastFileName  String?   @map("last_file_name")
  lastError     String?   @map("last_error")
  /// Kaynağın zorunlu atıf metni (ör. VehiclesDB ATTRIBUTION.md); sitenin "Veri kaynakları" sayfasında gösterilir
  notice        String?
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  imports CatalogImport[]

  @@map("catalog_sources")
}

enum CatalogImportStatus {
  APPLIED
  REJECTED
  FAILED
  SKIPPED
}

/// Her içe aktarma denemesi: hangi dosya, kim, kalite raporu ve sonuç.
model CatalogImport {
  id        String              @id @db.Uuid
  sourceKey String              @map("source_key")
  version   String?
  fileName  String?             @map("file_name")
  /// İmzalı paketin özeti; aynı paket ikinci kez uygulanmaz
  sha256    String?
  /// elle | otomatik
  trigger   String
  status    CatalogImportStatus
  stats     Json                @default("{}")
  quality   Json                @default("{}")
  error     String?
  createdBy String?             @map("created_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  source CatalogSource @relation(fields: [sourceKey], references: [key])

  @@index([sourceKey, createdAt])
  @@map("catalog_imports")
}

model CatalogMake {
  id        String   @id @db.Uuid
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  series   CatalogSeries[]
  models   CatalogModel[]
  trims    CatalogTrim[]
  variants CatalogVariant[]

  @@map("catalog_makes")
}

/// Seri (BMW 3 Serisi, VW Golf). Motosiklet ve ATV'de seri katmanı yoktur.
model CatalogSeries {
  id         String   @id @db.Uuid
  key        String   @unique
  makeId     String   @map("make_id") @db.Uuid
  name       String
  /// Bu serinin tiplerinin girdiği kategoriler (Karar 19 sözlüğü)
  categories String[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  make        CatalogMake         @relation(fields: [makeId], references: [id])
  models      CatalogModel[]
  trims       CatalogTrim[]
  variants    CatalogVariant[]
  generations CatalogGeneration[]

  @@index([makeId])
  @@map("catalog_series")
}

/// Model: motor sürümü (BMW 320i, VW 1.0 TSI, Mercedes C 200 d)
model CatalogModel {
  id        String   @id @db.Uuid
  key       String   @unique
  makeId    String   @map("make_id") @db.Uuid
  seriesId  String?  @map("series_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  make     CatalogMake      @relation(fields: [makeId], references: [id])
  series   CatalogSeries?   @relation(fields: [seriesId], references: [id])
  variants CatalogVariant[]

  @@index([seriesId])
  @@index([makeId])
  @@map("catalog_models")
}

/// Donanım paketi (Karar 32): BMW M Sport, VW Highline, Renault Joy. Seri düzeyinde tutulur.
model CatalogTrim {
  id        String   @id @db.Uuid
  key       String   @unique
  makeId    String   @map("make_id") @db.Uuid
  seriesId  String?  @map("series_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  make     CatalogMake      @relation(fields: [makeId], references: [id])
  series   CatalogSeries?   @relation(fields: [seriesId], references: [id])
  variants CatalogVariant[]

  @@index([seriesId])
  @@map("catalog_trims")
}

/// Kasa kuşağı (nesil): ör. BMW 3 Serisi Sedan 1998–2002. Kaynağıyla tutulur; açık kaynaklardan gelir (Karar 32–33).
model CatalogGeneration {
  id              String   @id @db.Uuid
  key             String   @unique
  seriesId        String   @map("series_id") @db.Uuid
  source          String
  name            String
  /// Nesil kodu (ör. E46, G20); açık kaynaklardan (Wikidata) gelince dolar
  code            String?
  startYear       Int      @map("start_year")
  endYear         Int?     @map("end_year")
  /// Kasa tipi (Sedan, Station wagon …); vehicle-makes-models kuşağı kasa başına ayrı verir. Kod satırında boş.
  body            String?
  /// 0: makyajsız, 1: ilk makyaj, 2: ikinci makyaj; bilinmiyorsa boş (Wikidata kodu eşleşince dolar)
  facelift        Int?
  /// Kod satırının Wikidata kimliği (Q…); kuşak satırına eşleşince kopyalanır
  wikidataId      String?  @map("wikidata_id")
  /// Wikimedia Commons kategorisi (Karar 34: fotoğraf adayları buradan aranır)
  commonsCategory String?  @map("commons_category")
  /// Yılların alındığı yer (ör. İngilizce Vikipedi maddesi ve sürüm numarası)
  yearsSource     String?  @map("years_source")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  series   CatalogSeries    @relation(fields: [seriesId], references: [id])
  variants CatalogVariant[]
  images   CatalogImage[]

  @@index([seriesId])
  @@map("catalog_generations")
}

/// Nesil fotoğrafı (Karar 34): Wikimedia Commons'tan açık lisanslı gerçek fotoğraf. Sistem nesil kodunun Commons
/// kategorisinden aday bulur, katalog sorumlusu seçer; seçilen fotoğrafın kopyası atfıyla SeaweedFS'e alınır.
/// Yalnızca ticari kullanıma izin veren lisanslar (kamu malı, CC0, CC BY, CC BY-SA); NC ve ND alınmaz.
model CatalogImage {
  id           String    @id @db.Uuid
  /// Nesil kodu satırı (Wikidata kaynağı; kasa kuşakları kodla bu fotoğrafı paylaşır)
  generationId String    @map("generation_id") @db.Uuid
  /// Commons dosya adı (File:… olmadan)
  commonsFile  String    @map("commons_file")
  /// Commons dosya sayfası
  pageUrl      String    @map("page_url")
  /// Özgün dosya adresi ve ölçüleri
  sourceUrl    String    @map("source_url")
  width        Int
  height       Int
  mime         String
  /// Yazar (düz metin, HTML ayıklanmış) ve lisans
  author       String
  license      String
  licenseUrl   String?   @map("license_url")
  /// Sıralama puanı: büyüklük, yatay kadraj, dosya adındaki ipuçları (ön, iç mekân, motor …)
  score        Int       @default(0)
  /// aday | secildi | reddedildi
  status       String    @default("aday")
  /// Seçilince depodaki kopyanın anahtarı ve özeti
  storageKey   String?   @map("storage_key")
  sha256       String?
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  generation CatalogGeneration @relation(fields: [generationId], references: [id])

  @@unique([generationId, commonsFile])
  @@index([status])
  @@map("catalog_images")
}

/// Ad eşleme (Teknik tasarım §5, Karar 33): bir kaynaktaki seri yazımı katalogdaki seriye bağlanır
/// (vehicle-makes-models "Focus CC" → Ford Focus, TSB "Touraeg" → Touareg). Kural önerir, katalog sorumlusu onaylar.
/// Onaylanan eşleme içe aktarmada uygulanır ve var olan tipler hedef seriye taşınır. Kayıtlar silinmez.
model CatalogAlias {
  id        String    @id @db.Uuid
  /// Kaynak anahtarı (tsb, vmm, wikidata); "*" bütün kaynaklar
  source    String
  /// Kaynaktaki seri anahtarı (ör. ford/focus-cc)
  fromKey   String    @map("from_key")
  /// Kaynaktaki yazım, olduğu gibi
  fromName  String    @map("from_name")
  /// Hedef seri anahtarı (ör. ford/focus)
  toKey     String    @map("to_key")
  /// onerildi | onaylandi | reddedildi
  status    String    @default("onerildi")
  /// kural (sistem önerdi) | elle (çalışan ekledi) | ajan
  method    String
  /// Önerinin gerekçesi: "önek", "yazım farkı", "bitişik yazım" …
  reason    String?
  /// Kaynak seride kaç tip var (önceliklendirme için)
  variants  Int       @default(0)
  createdBy String?   @map("created_by") @db.Uuid
  decidedBy String?   @map("decided_by") @db.Uuid
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([source, fromKey])
  @@index([status])
  @@map("catalog_aliases")
}

/// Kaynaktaki bir araç tipi (TSB'de bir satır). Kaynağı ve kimliği saklanır; TSB kayıtları ayrılabilir (Karar 33).
model CatalogVariant {
  id           String   @id @db.Uuid
  source       String
  sourceKey    String   @map("source_key")
  makeId       String   @map("make_id") @db.Uuid
  seriesId     String?  @map("series_id") @db.Uuid
  modelId      String   @map("model_id") @db.Uuid
  trimId       String?  @map("trim_id") @db.Uuid
  generationId String?  @map("generation_id") @db.Uuid
  categories   String[]
  body         String?
  engineL      Float?   @map("engine_l")
  powerHp      Int?     @map("power_hp")
  powerKw      Int?     @map("power_kw")
  fuel         String?
  gearbox      String?
  drive        String?
  /// Makyajlı kasa (TSB tip adında BMW "LCI", Mercedes "FL")
  facelift     Boolean  @default(false)
  /// Tipin var olduğu model yılları
  years        Int[]
  /// Kaynaktaki yazımı, olduğu gibi
  rawName      String   @map("raw_name")
  confidence   String
  /// Kaynağın son sürümünde var mı; düşenler silinmez, işaretlenir
  inLatest     Boolean  @default(true) @map("in_latest")
  firstVersion String   @map("first_version")
  lastVersion  String   @map("last_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  make       CatalogMake        @relation(fields: [makeId], references: [id])
  series     CatalogSeries?     @relation(fields: [seriesId], references: [id])
  model      CatalogModel       @relation(fields: [modelId], references: [id])
  trim       CatalogTrim?       @relation(fields: [trimId], references: [id])
  generation CatalogGeneration? @relation(fields: [generationId], references: [id])

  @@unique([source, sourceKey])
  @@index([seriesId])
  @@index([modelId])
  @@map("catalog_variants")
}

/// Sürümlü yasal metin (Karar 46, Teknik tasarım consent_texts): kullanım koşulları, KVKK aydınlatma, açık rıza,
/// ticari ileti, çerez politikası, sözleşmeler. Bir sürüm yayınlandıktan sonra değişmez; değişiklik yeni sürümdür.
model ConsentText {
  id          String    @id @db.Uuid
  /// kullanim_kosullari | kvkk_aydinlatma | reklam_olcum | ticari_ileti | cerez_politikasi | on_bilgilendirme | mesafeli_sozlesme | galeri_sozlesmesi
  key         String
  version     Int
  title       String
  /// Markdown
  body        String
  /// taslak | yayinda | eski
  status      String    @default("taslak")
  /// Esaslı değişiklik: yayınlanınca kullanıcılara yeniden onaylatılır
  material    Boolean   @default(false)
  createdBy   String?   @map("created_by") @db.Uuid
  publishedBy String?   @map("published_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, version])
  @@map("consent_texts")
}

/// Rıza ve onay kaydı (Karar 39 "rıza kayıtları", Karar 46): kim, hangi metnin hangi sürümünü, ne zaman, hangi
/// kanaldan onayladı ya da reddetti. Yalnızca ekleme; güncel durum her türün en son kaydıdır.
model Consent {
  id          String   @id @db.Uuid
  /// Üye; ziyaretçinin çerez tercihi için boş
  userId      String?  @map("user_id") @db.Uuid
  /// Ziyaretçi kimliği (çerez tercihi, rastgele; kişiyi tanımlamaz)
  visitorId   String?  @map("visitor_id")
  /// kullanim_kosullari | kvkk_aydinlatma | ticari_ileti | reklam_olcum | cerez_analiz | cerez_reklam | galeri_sozlesmesi
  kind        String
  granted     Boolean
  textKey     String?  @map("text_key")
  textVersion Int?     @map("text_version")
  /// web | ios | android
  channel     String
  /// @pii
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, kind, createdAt])
  @@index([visitorId])
  @@map("consents")
}

// ── Kategoriler (Aşama 2; Karar 23, 45; Teknik tasarım §4–5) ──────
// Ağaç: dikey (vasıta; ileride emlak, ikinci el) > kategori > alt kategori. Şema sürümlüdür: alanlar, kurallar ve
// eşleştirme ağırlıkları sürümün tanımındadır (packages/shared/src/category-schema.ts); taban şema koddadır.

/// Kategori ağacı. Kapalı kategori menüde görünmez ve talep açılamaz (ör. Ticari Hat & Plaka, Karar 19).
model Category {
  id               String   @id @db.Uuid
  slug             String   @unique
  /// vasita | emlak | ikinci_el
  vertical         String   @default("vasita")
  parentId         String?  @map("parent_id") @db.Uuid
  name             String
  sort             Int      @default(0)
  enabled          Boolean  @default(false)
  /// Nokta rengi; boşsa sıradaki renk (Anasayfa.dc.html DOTS)
  color            String?
  /// Yayındaki şema sürümü; talep oluşturulduğu sürümü ayrıca taşır
  publishedVersion Int?     @map("published_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?               @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]              @relation("CategoryTree")
  versions CategorySchemaVersion[]
  demands  Demand[]
  vehicles PortfolioVehicle[]

  @@index([parentId, sort])
  @@map("categories")
}

enum CategoryVersionStatus {
  DRAFT
  PENDING
  PUBLISHED
  RETIRED
}

/// Kategori şemasının sürümleri: taslak → dört göz onayı → yayında; yerine yenisi gelince "eski" olur.
/// Taslak dışındaki sürümün tanımı değişmez ve hiçbir sürüm silinmez (rr_category_version_guard).
model CategorySchemaVersion {
  id           String                @id @db.Uuid
  categoryId   String                @map("category_id") @db.Uuid
  version      Int
  status       CategoryVersionStatus @default(DRAFT)
  /// Kategori alanları, kurallar ve ağırlıklar (CategoryDefinition)
  definition   Json
  /// Önceki yayına göre değişiklikler (konsoldaki Sürümler)
  changes      String[]              @default([])
  /// Geri dönüşte hangi sürümden kopyalandığı
  restoredFrom Int?                  @map("restored_from")
  createdBy    String?               @map("created_by") @db.Uuid
  approvalId   String?               @unique @map("approval_id") @db.Uuid
  publishedBy  String?               @map("published_by") @db.Uuid
  publishedAt  DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, version])
  @@map("category_schema_versions")
}

// ── Talepler (Aşama 3; Karar 04, 05, 09, 10, 21; Teknik tasarım §4) ─────
// Talep oluşturulduğu kategori şeması sürümünü taşır. Sık filtrelenen alanlar ayrı sütunda, gerisi `data` içinde
// (`{ alanlar, alternatifler }`, packages/shared demandSchema). Talep silinmez; kapatılır.

enum DemandStatus {
  DRAFT
  PUBLISHED
  PASSIVE
  CLOSED
  COMPLETED
}

model Demand {
  id                String       @id @db.Uuid
  /// Kullanıcıya görünen talep numarası ("Talep No 1052187")
  no                BigInt       @unique @default(autoincrement())
  accountId         String       @map("account_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  categoryId        String       @map("category_id") @db.Uuid
  /// Yayına girdiği şema sürümü; eski talepler bu sürümle okunur (Karar 45)
  schemaVersion     Int?         @map("schema_version")
  status            DemandStatus @default(DRAFT)
  /// Katalogdan üretilen başlık ("BMW 3 Serisi 320i")
  title             String       @default("")
  /// @pii Alıcının yazdığı talep başlığı (Sihirbaz 5. adım); boşsa `title` gösterilir
  headline          String?
  /// @pii Talep alanları ve alternatifler; açıklama serbest metindir
  data              Json         @default("{}")
  /// Taslakta kalınan sihirbaz adımı (Karar 21)
  step              Int          @default(1)
  makeKey           String?      @map("make_key")
  seriesKey         String?      @map("series_key")
  modelKey          String?      @map("model_key")
  il                String?
  ilce              String?
  /// Alternatiflerin en düşük ve en yüksek bütçesi (TL)
  budgetMin         BigInt?      @map("budget_min")
  budgetMax         BigInt?      @map("budget_max")
  yearMin           Int?         @map("year_min")
  yearMax           Int?         @map("year_max")
  /// İletişim izni (Karar 11.4, 29): telefon ve WhatsApp görünsün mü, ad tam mı "Ayşe Y." mi
  phoneVisible      Boolean      @default(false) @map("phone_visible")
  whatsappVisible   Boolean      @default(false) @map("whatsapp_visible")
  /// tam | kisa
  nameMode          String       @default("tam") @map("name_mode")
  /// Hangi hakla yayına girdi: ucretsiz | ek | paket
  entitlement       String?
  publishedAt       DateTime?    @map("published_at") @db.Timestamptz(3)
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz(3)
  /// Son gönderilen bitiş hatırlatması (7, 3, 1 gün kala)
  reminderDays      Int?         @map("reminder_days")
  passiveAt         DateTime?    @map("passive_at") @db.Timestamptz(3)
  /// sure_doldu | kullanici
  passiveReason     String?      @map("passive_reason")
  /// Ajanın düzeltme isteği (Karar 41): başlık ya da açıklamada telefon, IBAN, e-posta, bağlantı ya da uygunsuz ifade.
  /// Talep yayında kalır, bu bilgiler herkese açık görünümde gizlenir; sahibi düzeltince temizlenir.
  correctionFlags   String[]     @default([]) @map("correction_flags")
  correctionAt      DateTime?    @map("correction_at") @db.Timestamptz(3)
  closedAt          DateTime?    @map("closed_at") @db.Timestamptz(3)
  /// Aracı buldum: rengarenk | baska_site | tanidik | vazgectim (Karar 31; satıcıya gösterilmez)
  foundVia          String?      @map("found_via")
  /// Talebin açıldığı platform (WEB | IOS | ANDROID; kontrol paneli kırılımı, Karar 44)
  platform          String?
  /// Ücretsiz uzatma kullanıldı mı (Karar 10, 12.1)
  freeExtensionUsed Boolean      @default(false) @map("free_extension_used")
  extensionCount    Int          @default(0) @map("extension_count")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events        DemandEvent[]
  favorites     Favorite[]
  matches       Match[]
  conversations Conversation[]
  promotions    DemandPromotion[]

  @@index([accountId, status])
  @@index([status, categoryId, publishedAt])
  @@index([status, expiresAt])
  @@map("demands")
}

/// Talebin geçmişi: oluşturma, yayın, düzenleme, pasife alma, uzatma, kapanış. Yalnızca ekleme.
model DemandEvent {
  id        BigInt   @id @default(autoincrement())
  demandId  String   @map("demand_id") @db.Uuid
  type      String
  /// Kullanıcı; sistem işlerinde (süre dolumu) boş
  userId    String?  @map("user_id") @db.Uuid
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  demand Demand @relation(fields: [demandId], references: [id])

  @@index([demandId, id])
  @@map("demand_events")
}

/// Favori talepler (Karar 06.4): talep güncellenince, pasife alınınca ya da kapanınca ekleyene bildirim gider.
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  demandId  String   @map("demand_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  demand Demand @relation(fields: [demandId], references: [id], onDelete: Restrict)

  @@id([userId, demandId])
  @@index([demandId])
  @@map("favorites")
}

/// Kayıtlı arama (Karar 30): en fazla 10; her biri için anlık, günlük özet ya da kapalı bildirim.
model SavedSearch {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  /// Liste filtreleri (GET /talepler sorgusu)
  query      Json
  /// anlik | gunluk | kapali
  notify     String   @default("anlik")
  /// "N yeni" bu tarihten sonra yayınlananlar
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// ── Galeri hesapları (Karar 03, 12.5, 17, 20) ─────────────────

enum GalleryApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  DOCS_REQUESTED
  APPROVED
  REJECTED
  REVOKED
}

/// Kurumsal hesap başvurusu (Basvuru.dc.html). Kontrollerin hepsi geçerse ajan onaylar; biri bile geçmezse
/// başvuru insan incelemesine düşer. Onayda galeri hesabı (accounts, galleries) açılır. Kullanıcı başına tek açık
/// başvuru olur (veritabanı kısıtı). Silinmez.
model GalleryApplication {
  id             String                   @id @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  businessKind   BusinessKind?            @map("business_kind")
  status         GalleryApplicationStatus @default(DRAFT)
  /// @pii Form: ticari unvan, vergi no, MERSİS, adres, yetki belgesi no, hesap sahibinin adı ve e-postası
  data           Json                     @default("{}")
  /// Otomatik kontrol sonuçları: [{ key, sonuc, not }]
  checks         Json?
  /// Kontrollerin özeti (konsolda "Ajan:" satırı)
  agentNote      String?                  @map("agent_note")
  submittedAt    DateTime?                @map("submitted_at") @db.Timestamptz(3)
  checkedAt      DateTime?                @map("checked_at") @db.Timestamptz(3)
  decidedAt      DateTime?                @map("decided_at") @db.Timestamptz(3)
  /// Karar veren çalışan; ajan onayında boş
  decidedBy      String?                  @map("decided_by") @db.Uuid
  decidedByAgent Boolean                  @default(false) @map("decided_by_agent")
  /// Ret gerekçesi ya da istenen belge açıklaması (başvurana gösterilir)
  decisionNote   String?                  @map("decision_note")
  /// Onayda açılan galeri hesabı
  accountId      String?                  @unique @map("account_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id])
  documents GalleryDocument[]

  @@index([userId])
  @@index([status, submittedAt])
  @@map("gallery_applications")
}

/// Başvuru belgesi: dosya özel depoda (SeaweedFS, Türkiye), yalnızca çalışanlar görür.
model GalleryDocument {
  id            String   @id @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  /// vergi_levhasi, sicil_gazetesi, oda_kayit, sube_adresleri, turizm_belgesi
  kind          String
  /// @pii Yüklenen dosyanın adı
  fileName      String   @map("file_name")
  mime          String
  size          Int
  sha256        String
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application GalleryApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId, kind])
  @@map("gallery_documents")
}

/// Galeri profili (GaleriProfil.dc.html): galeri hesabıyla bire bir. Yetki belgesi no ve işletme adı profilde ve
/// portföy araçlarında görünür (yönetmelik m.21).
model Gallery {
  accountId         String       @id @map("account_id") @db.Uuid
  slug              String       @unique
  businessKind      BusinessKind @map("business_kind")
  displayName       String       @map("display_name")
  /// @pii Ticari unvan (şahıs işletmesinde kişinin adı geçer)
  legalName         String       @map("legal_name")
  /// @pii Vergi no (şahıs işletmesinde T.C. kimlik no)
  taxNo             String       @map("tax_no")
  taxOffice         String       @map("tax_office")
  /// @pii
  mersisNo          String       @map("mersis_no")
  il                String
  ilce              String
  /// @pii
  address           String
  /// Bakanlık yetki belgesi numarası (vasıta galerisi ve kiralama)
  authorityNo       String?      @map("authority_no")
  about             String?
  workingHours      String?      @map("working_hours")
  /// deneme | baslangic | profesyonel | kurumsal (abonelik ödeme modülüyle, Aşama 6)
  plan              String       @default("deneme")
  trialEndsAt       DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  /// Müşteri yönetimi (Karar 43): galeriden sorumlu çalışan ve atama zamanı
  managerStaffId    String?      @map("manager_staff_id") @db.Uuid
  managerSetAt      DateTime?    @map("manager_set_at") @db.Timestamptz(3)
  /// Deneme bitişi için gönderilen hatırlatmalar (7, 3, 1 gün)
  trialReminderDays Int[]        @default([]) @map("trial_reminder_days")
  applicationId     String       @unique @map("application_id") @db.Uuid
  approvedAt        DateTime     @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([il])
  @@index([managerStaffId])
  @@map("galleries")
}

/// Galeri çalışan daveti (Karar 20): davet edilen numara giriş yapınca kabul eder. 7 gün geçerlidir.
model AccountInvite {
  id         String     @id @db.Uuid
  accountId  String     @map("account_id") @db.Uuid
  /// @pii E.164
  phone      String
  role       MemberRole
  invitedBy  String     @map("invited_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([phone])
  @@index([accountId])
  @@map("account_invites")
}

// ── Galeri portföyü (Karar 07, 17; Aşama 4) ───────────────────

enum PortfolioStatus {
  DRAFT
  PENDING_EIDS
  PUBLISHED
  PASSIVE
  SOLD
  REJECTED
}

/// Portföy aracı. Alıcılara yalnızca EİDS onaylı ve yayındaki araç görünür (m.22/ç); satılan araç hemen kalkar (m.21).
/// Araç silinmez (uyum kaydı); satıldı ya da pasif olur. Yakıt, vites, renk ve hasar anahtarları talep şemasıyla aynıdır.
model PortfolioVehicle {
  id                String          @id @db.Uuid
  /// Portföy no (77100001'den başlar)
  no                BigInt          @unique @default(autoincrement())
  accountId         String          @map("account_id") @db.Uuid
  categoryId        String          @map("category_id") @db.Uuid
  makeKey           String?         @map("make_key")
  seriesKey         String?         @map("series_key")
  modelKey          String?         @map("model_key")
  /// Kasa kuşağı: "G20:0" ya da kuşak anahtarı
  generationKey     String?         @map("generation_key")
  trimKey           String?         @map("trim_key")
  /// Katalogda olmayan araçlar için marka ve model adı
  makeName          String?         @map("make_name")
  modelName         String?         @map("model_name")
  year              Int
  km                Int
  fuel              String?
  gearbox           String?
  color             String?
  priceTl           BigInt          @map("price_tl")
  /// @pii Plaka (EİDS); alıcıya yalnızca il kodu gösterilir
  plate             String?
  /// @pii Şasi numarasının son 6 hanesi
  chassisTail       String?         @map("chassis_tail")
  firstRegistration DateTime?       @map("first_registration") @db.Date
  lien              Boolean         @default(false)
  warranty          String?
  tradeIn           Boolean         @default(false) @map("trade_in")
  /// Parça durumları, tramer, şasi/podye, airbag, ağır hasar (damageSchema)
  damage            Json
  description       String?
  /// Fiyatın üretici tavsiye fiyatını aşmadığı beyanı ve bilinen üretici fiyatı (geçici m.2)
  priceDeclared     Boolean         @default(false) @map("price_declared")
  manufacturerPrice BigInt?         @map("manufacturer_price")
  /// Galerinin fotoğraflarını katalogda temsilî görsel olarak kullanma izni (GaleriMobil.dc.html; galeri adıyla)
  photoCatalogOk    Boolean         @default(false) @map("photo_catalog_ok")
  /// Galerinin stok numarası (toplu yükleme ve API); galeri içinde tekil
  externalId        String?         @map("external_id")
  status            PortfolioStatus @default(DRAFT)
  statusNote        String?         @map("status_note")
  /// Moderasyon yayından kaldırdı: galeri yeniden yayına alamaz, itiraz kabul edilirse kalkar (Karar 53)
  moderatedAt       DateTime?       @map("moderated_at") @db.Timestamptz(3)
  /// Aracı düzenleyebilen satış temsilcisi (Karar 20)
  assignedTo        String?         @map("assigned_to") @db.Uuid
  createdBy         String          @map("created_by") @db.Uuid
  /// Ekspertiz raporu (özel depo) ve tarihi (m.16)
  reportKey         String?         @map("report_key")
  reportName        String?         @map("report_name")
  reportDate        DateTime?       @map("report_date") @db.Date
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz(3)
  passiveAt         DateTime?       @map("passive_at") @db.Timestamptz(3)
  soldAt            DateTime?       @map("sold_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  account       Account          @relation(fields: [accountId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  photos        PortfolioPhoto[]
  eidsChecks    EidsCheck[]
  matches       Match[]
  conversations Conversation[]

  @@unique([accountId, externalId])
  @@index([accountId, status])
  @@index([status, publishedAt])
  @@map("portfolio_vehicles")
}

/// Portföy fotoğrafı (depoda); sıra 0'dan başlar, ilki kapak
model PortfolioPhoto {
  id         String   @id @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  storageKey String   @map("storage_key")
  mime       String
  size       Int
  sha256     String
  sort       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle PortfolioVehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, sort])
  @@index([sha256])
  @@map("portfolio_photos")
}

enum EidsStatus {
  PENDING
  APPROVED
  REJECTED
}

/// EİDS (Elektronik İlan Doğrulama Sistemi) isteği: ruhsat sahibinin ilan onayı. İşçi sağlayıcıya sorar.
model EidsCheck {
  id          String     @id @db.Uuid
  vehicleId   String     @map("vehicle_id") @db.Uuid
  status      EidsStatus @default(PENDING)
  /// none | fake | (gerçek bağdaştırıcı)
  provider    String
  reference   String?
  note        String?
  /// @pii İstek anındaki plaka
  plate       String
  attempts    Int        @default(0)
  requestedAt DateTime   @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedAt   DateTime?  @map("decided_at") @db.Timestamptz(3)

  vehicle PortfolioVehicle @relation(fields: [vehicleId], references: [id])

  @@index([status, requestedAt])
  @@index([vehicleId])
  @@map("eids_checks")
}

/// Galeri API anahtarı (Karar 07.3; Kurumsal paket). Anahtarın kendisi saklanmaz, SHA-256 özeti saklanır.
model ApiKey {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  name       String
  /// Gösterim için ilk karakterler: "rgk_8f3a…"
  prefix     String
  hash       String    @unique
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("api_keys")
}

/// Talep ile portföy aracının eşleşmesi (Karar 06.2, Teknik tasarım §6). Skor, hesaplandığı kategori şeması
/// sürümüyle saklanır. Talep ya da araç yayından kalkınca satır silinmez, `active` kapanır.
model Match {
  id            String    @id @db.Uuid
  demandId      String    @map("demand_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  /// Aracın galerisi
  accountId     String    @map("account_id") @db.Uuid
  score         Int
  /// En iyi uyan alternatif (0'dan)
  alternative   Int
  /// Ölçütler: anahtar, kısa ad, ağırlık, uyum, alıcının seçimi var mı (kişisel veri yok)
  criteria      Json
  schemaVersion Int       @map("schema_version")
  active        Boolean   @default(true)
  /// Galeri eşleşmeler ekranını açtı
  seenAt        DateTime? @map("seen_at") @db.Timestamptz(3)
  /// anlik | ozet: "sana uygun talep" bildirimi olayı yazıldı (eşik üstü, günde 20 anlık)
  notified      String?
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz(3)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  demand  Demand           @relation(fields: [demandId], references: [id])
  vehicle PortfolioVehicle @relation(fields: [vehicleId], references: [id])
  account Account          @relation(fields: [accountId], references: [id])

  @@unique([demandId, vehicleId])
  @@index([accountId, active, score])
  @@index([vehicleId, active])
  @@index([accountId, notifiedAt])
  @@map("matches")
}

enum ConversationStatus {
  /// Satıcı ilk mesajı attı, alıcı yanıtlamadı; satıcı ikinci mesaj atamaz (Karar 11.1)
  WAITING
  /// Alıcı yanıtladı ya da sohbeti alıcı başlattı (Karar 27); iki taraf serbestçe yazar
  OPEN
  /// Alıcı "İlgilenmiyorum" dedi; satıcı bu talebe yeniden yazamaz
  DECLINED
}

/// Sohbet (Karar 08, 11, 27): bir talebe bir satıcı hesabından tek ilk mesaj ya da alıcının bir portföy aracı için
/// galeriye yazması. Galeri sohbetini hesabın bütün çalışanları görür (Karar 20).
model Conversation {
  id              String             @id @db.Uuid
  /// talep | arac
  origin          String
  demandId        String?            @map("demand_id") @db.Uuid
  /// Araç sohbetinde aracın kendisi (Karar 27)
  vehicleId       String?            @map("vehicle_id") @db.Uuid
  buyerUserId     String             @map("buyer_user_id") @db.Uuid
  /// Satıcı hesabı: galeri ya da bireysel satıcının kişisel hesabı
  sellerAccountId String             @map("seller_account_id") @db.Uuid
  /// İlk mesajı yazan kişi (galeride çalışan)
  sellerUserId    String             @map("seller_user_id") @db.Uuid
  status          ConversationStatus
  /// İlk mesaj hangi hakla: gunluk | paket | ek | alici (alıcı başlattı, hak düşmez)
  entitlement     String
  /// Satıcı mesajlarından biri güvenlik uyarısı aldı (Karar 25: "Uyarılı" süzgeci)
  warned          Boolean            @default(false)
  /// Alıcı numarasını bu sohbette paylaştı (Teknik tasarım §8)
  phoneSharedAt   DateTime?          @map("phone_shared_at") @db.Timestamptz(3)
  lastMessageAt   DateTime           @map("last_message_at") @db.Timestamptz(3)
  buyerReadAt     DateTime?          @map("buyer_read_at") @db.Timestamptz(3)
  sellerReadAt    DateTime?          @map("seller_read_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  demand        Demand?           @relation(fields: [demandId], references: [id])
  vehicle       PortfolioVehicle? @relation(fields: [vehicleId], references: [id])
  buyer         User              @relation("alici", fields: [buyerUserId], references: [id])
  sellerAccount Account           @relation("satici", fields: [sellerAccountId], references: [id])
  messages      Message[]
  rating        Rating?

  @@index([buyerUserId, lastMessageAt])
  @@index([sellerAccountId, lastMessageAt])
  @@index([sellerAccountId, createdAt])
  @@map("conversations")
}

/// Mesaj: gövde şifreli saklanır (Teknik tasarım §8). Sistem mesajı ve araç kartı da satırdır.
model Message {
  id             String    @id @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  /// alici | satici | sistem
  side           String
  senderUserId   String?   @map("sender_user_id") @db.Uuid
  /// metin | kart | sistem
  kind           String
  /// @pii Şifreli metin (AES-256-GCM); kartta ve sistem mesajında da şifreli
  body           String
  /// Araç kartı (Karar 26)
  vehicleId      String?   @map("vehicle_id") @db.Uuid
  /// Güvenlik kuralları: kapora, odeme, iban, telefon, baglanti (Karar 25)
  flags          String[]  @default([])
  /// Moderasyon gizledi (Karar 53): karşı tarafa "Bu mesaj gizlendi" görünür
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Alıcının engellediği satıcı hesabı (Karar 11.3): engellenen hesap o alıcıya yazamaz.
model UserBlock {
  userId    String   @map("user_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@id([userId, accountId])
  @@map("user_blocks")
}

/// Alıcının satıcıya verdiği yıldız (Karar 55): sohbet başına bir kez, yorum yok. Şüpheli yıldız hesaba katılmaz.
model Rating {
  id              String   @id @db.Uuid
  conversationId  String   @unique @map("conversation_id") @db.Uuid
  buyerUserId     String   @map("buyer_user_id") @db.Uuid
  sellerAccountId String   @map("seller_account_id") @db.Uuid
  stars           Int
  /// yeni_hesap | ayni_cihaz | bagli_hesap: hesaba katılmaz
  flag            String?
  counted         Boolean  @default(true)
  /// @pii IP ve tarayıcının anahtarlı özeti (aynı cihazdan çok hesap tespiti); kendisi saklanmaz
  fingerprint     String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation  Conversation  @relation(fields: [conversationId], references: [id])
  buyer         User          @relation(fields: [buyerUserId], references: [id])
  sellerAccount Account       @relation(fields: [sellerAccountId], references: [id])
  appeal        RatingAppeal?

  @@index([sellerAccountId, createdAt])
  @@index([sellerAccountId, fingerprint])
  @@map("ratings")
}

/// Galerinin 1 yıldıza itirazı (Karar 55): yıldız başına bir kez; moderasyon inceler, kabulde yıldız hesaba katılmaz
model RatingAppeal {
  id               String    @id @db.Uuid
  ratingId         String    @unique @map("rating_id") @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  /// İtirazı yazan galeri çalışanı (sahip ya da yönetici)
  userId           String    @map("user_id") @db.Uuid
  /// @pii İtiraz metni
  text             String
  /// acik | kabul | red
  status           String    @default("acik")
  /// İnceleme hedefi (7 gün)
  dueAt            DateTime  @map("due_at") @db.Timestamptz(3)
  decidedByStaffId String?   @map("decided_by_staff_id") @db.Uuid
  decisionNote     String?   @map("decision_note")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  rating Rating @relation(fields: [ratingId], references: [id])

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@map("rating_appeals")
}

/// Satıcının hesaplanmış göstergeleri ve rozetleri (Karar 55); işçi her gece ve yeni yıldızda yeniler
model SellerStats {
  accountId      String   @id @map("account_id") @db.Uuid
  ratingCount    Int      @default(0) @map("rating_count")
  ratingAvg      Float?   @map("rating_avg")
  /// 1'den 5'e yıldız sayıları
  ratingDist     Int[]    @default([0, 0, 0, 0, 0]) @map("rating_dist")
  responseConvs  Int      @default(0) @map("response_convs")
  responseMedian Int?     @map("response_median")
  responseAvg    Int?     @map("response_avg")
  complaintRate  Float    @default(0) @map("complaint_rate")
  score          Int      @default(0)
  badges         String[] @default([])
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@map("seller_stats")
}

/// Galeriyi takip et (Karar 28): galeri takipçilerini tek tek görmez, yalnızca sayısını
model GalleryFollow {
  userId    String    @map("user_id") @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Son günlük özetin gönderildiği an
  digestAt  DateTime? @map("digest_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@id([userId, accountId])
  @@index([accountId])
  @@map("gallery_follows")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// Sipariş (Karar 12.8, 31, 39): sepet, fatura bilgileri, ödeme onayları ve doldurulmuş ön bilgilendirme formu.
/// Ödeme ve fatura kayıtları vergi mevzuatı gereği 10 yıl saklanır (Karar 59); sipariş silinmez.
model Order {
  id             String      @id @db.Uuid
  /// Kullanıcıya ve ödeme kuruluşuna giden sipariş no (merchant_oid; harf ve rakam)
  no             String      @unique
  accountId      String      @map("account_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  /// web | ios | android
  channel        String
  status         OrderStatus @default(PENDING)
  /// Kalemler: ürün, ad, birim fiyat (kuruş), adet, talep (öne çıkarmada)
  items          Json
  totalKurus     BigInt      @map("total_kurus")
  vatKurus       BigInt      @map("vat_kurus")
  /// @pii Fatura bilgileri: ad soyad, e-posta, il, ilçe, kurumsal fatura
  billing        Json
  /// Ödeme ekranındaki onaylar ve metin sürümleri (Karar 39)
  consents       Json
  /// Siparişe göre doldurulmuş ön bilgilendirme formu (3 yıl saklanır)
  preInfo        String      @map("pre_info")
  /// urun (bireysel ve galeri ek paketleri) | abonelik | yukseltme | yenileme (Karar 12.2, 12.7)
  kind           String      @default("urun")
  /// Mağaza satışında işlem no (App Store / Google Play transaction id); aynı satış iki kez işlenmez
  externalId     String?     @unique @map("external_id")
  subscriptionId String?     @map("subscription_id") @db.Uuid
  /// paytr | fake
  provider       String
  /// @pii Ödeme kuruluşuna giden müşteri IP'si
  userIp         String?     @map("user_ip")
  failReason     String?     @map("fail_reason")
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  account      Account           @relation(fields: [accountId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  payments     Payment[]
  invoice      Invoice?
  promotions   DemandPromotion[]
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id])
  refunds      Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("orders")
}

/// Ödeme kuruluşundan gelen bildirim (PayTR): aynı bildirim iki kez gelse de sipariş bir kez işlenir
model Payment {
  id          String   @id @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  provider    String
  /// success | failed
  status      String
  amountKurus BigInt   @map("amount_kurus")
  /// Taksit farkıyla tahsil edilen tutar (PayTR total_amount)
  totalKurus  BigInt   @map("total_kurus")
  /// card | eft
  method      String?
  failCode    String?  @map("fail_code")
  failMessage String?  @map("fail_message")
  testMode    Boolean  @default(false) @map("test_mode")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
}

/// e-Arşiv fatura (Karar 12.7, 31): ödeme onaylanınca entegratöre gönderilir, başarısızsa kuyrukta yeniden denenir
model Invoice {
  id        String        @id @db.Uuid
  orderId   String        @unique @map("order_id") @db.Uuid
  status    InvoiceStatus @default(PENDING)
  /// fake | entegratör adı
  provider  String
  /// Fatura no (entegratörden)
  no        String?
  /// Depodaki PDF
  pdfKey    String?       @map("pdf_key")
  attempts  Int           @default(0)
  lastError String?       @map("last_error")
  issuedAt  DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
  @@map("invoices")
}

/// Talebin öne çıkarması (Karar 12.6): üst sıra, acil arıyorum, ana sayfa vitrini; satın alındığı anda başlar
model DemandPromotion {
  id        String   @id @db.Uuid
  demandId  String   @map("demand_id") @db.Uuid
  /// ust_sira | acil | vitrin
  kind      String
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  orderId   String?  @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  demand Demand @relation(fields: [demandId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([demandId, kind, endsAt])
  @@index([kind, endsAt])
  @@map("demand_promotions")
}

enum SubscriptionStatus {
  ACTIVE
  /// Yenileme ödemesi alınamadı; 3 gün yeniden denenir, özellikler açık kalır
  PAST_DUE
  /// İptal edildi (dönem sonu) ya da ödeme alınamadığı için askıya alındı
  ENDED
}

/**
 * Fiyat listesi (Karar 47, 56; Kurallar ve fiyatlar): galeri paketlerinin fiyat ve sınırları, bireysel ürünlerin web
 * fiyatı. Dört göz onayıyla (PRICE_CHANGE) zamanlanır; yürürlük tarihi gelince geçerli olur. Satırlar silinmez; yenisi
 * eskisinin yerine geçer. Liste yoksa koddaki başlangıç değerleri geçerlidir.
 */
model PriceBook {
  id          String    @id @db.Uuid
  /// onay_bekliyor | zamanlandi | reddedildi | iptal
  status      String    @default("onay_bekliyor")
  /// PriceBook (packages/shared/src/pricing.ts)
  data        Json
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz(3)
  /// Değişiklik özeti ("Profesyonel · Aylık fiyat: 3.490 TL → 3.990 TL")
  changes     String[]  @default([])
  note        String?
  approvalId  String?   @unique @map("approval_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)

  @@index([status, effectiveAt])
  @@map("price_books")
}

/// Aylık hedefler (Karar 44): ay ("2026-11") ve ölçü başına bir değer; değişiklik işlem kaydına girer
model MonthlyGoal {
  month     String
  /// talep | buldum | gelir (kuruş değil TL) | ucretli_galeri | ana_olcu (yüzde)
  key       String
  value     Float
  updatedBy String   @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([month, key])
  @@map("monthly_goals")
}

/// Grafik notu (Karar 44): elle ya da fiyat, kural ve kampanya değişikliğinde kendiliğinden
model ChartNote {
  id        String   @id @db.Uuid
  day       DateTime @db.Date
  text      String
  /// elle | fiyat | kural | kampanya
  source    String
  refId     String?  @map("ref_id")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([day])
  @@map("chart_notes")
}

/// Galeri aboneliği (Karar 12.2, 12.3, 12.7, 39; Teknik tasarım §7): galeri başına tek satır, her dönem bir sipariş.
/// Kart bilgisi Rengarenk'te yoktur: ödeme kuruluşunun kullanıcı anahtarı (PayTR utoken) şifreli saklanır.
model Subscription {
  id                 String             @id @db.Uuid
  accountId          String             @unique @map("account_id") @db.Uuid
  /// Aboneliği başlatan ve kartı kaydeden kullanıcı (galeri sahibi)
  userId             String             @map("user_id") @db.Uuid
  /// baslangic | profesyonel | kurumsal
  plan               String
  /// aylik | yillik
  period             String
  status             SubscriptionStatus @default(ACTIVE)
  /// Dönemin KDV hariç fiyatı (kuruş); yıllık ödemede dönem sonuna kadar sabit
  priceKurus         BigInt             @map("price_kurus")
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  /// Aylık hak döngüsü (yıllık ödemede de haklar her ay yenilenir, devretmez); sıra hiç sıfırlanmaz
  quotaCycleStart    DateTime           @map("quota_cycle_start") @db.Timestamptz(3)
  quotaCycleNo       Int                @default(0) @map("quota_cycle_no")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelRequestedAt  DateTime?          @map("cancel_requested_at") @db.Timestamptz(3)
  /// Sonraki dönemde geçilecek paket ve ödeme dönemi (alt paket ya da aylık/yıllık değişikliği)
  nextPlan           String?            @map("next_plan")
  nextPeriod         String?            @map("next_period")
  /// Ödeme kuruluşundaki kart anahtarı, şifreli (SecretBox)
  cardToken          String?            @map("card_token")
  /// "VISA •••• 4242"
  cardLabel          String?            @map("card_label")
  /// @pii Faturanın gönderileceği e-posta
  billingEmail       String             @map("billing_email")
  /// Art arda başarısız yenileme sayısı ve sonraki deneme
  failCount          Int                @default(0) @map("fail_count")
  nextRetryAt        DateTime?          @map("next_retry_at") @db.Timestamptz(3)
  /// Yenileme hatırlatmasının gönderildiği dönem sonu
  remindedFor        DateTime?          @map("reminded_for") @db.Timestamptz(3)
  endedAt            DateTime?          @map("ended_at") @db.Timestamptz(3)
  /// iptal | odeme_alinamadi
  endReason          String?            @map("end_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])
  orders  Order[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Mağaza bildirimi (RevenueCat; Karar 38). Aynı bildirim bir kez işlenir; kayıt değiştirilmez ve silinmez.
/// İade bildirimleri yalnızca kaydedilir, hak düşülmez: iade akışı sahibin kararıyla (Teknik tasarım §7).
model StoreEvent {
  id            String   @id @db.Uuid
  /// revenuecat | fake
  provider      String
  /// Sağlayıcının olay kimliği
  eventId       String   @unique @map("event_id")
  type          String
  userId        String?  @map("user_id") @db.Uuid
  productId     String?  @map("product_id")
  transactionId String?  @map("transaction_id")
  /// APP_STORE | PLAY_STORE
  store         String?
  /// PRODUCTION | SANDBOX
  environment   String?
  /// islendi | yok_sayildi | inceleme
  result        String
  note          String?
  orderId       String?  @map("order_id") @db.Uuid
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([result, createdAt])
  @@map("store_events")
}

// ── Bildirim katmanı (Karar 48–51; Teknik tasarım §9) ─────────

/// Uygulama içi bildirim (zil). `tekil` aynı konudaki okunmamış bildirimi günceller (ör. aynı sohbette yeni mesaj).
model Notification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Şablon anahtarı (ör. talep.suresi_doluyor)
  sablon    String
  /// Süzgeç ve simge: mesaj | talep | guvenlik | kampanya | odeme | galeri
  grup      String
  /// @pii Başlık ve metin kişi ve talep adı içerebilir
  baslik    String
  /// @pii
  metin     String
  url       String?
  ticari    Boolean   @default(false)
  tekil     String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Kullanıcının konu ve kanal tercihi (Ayarlar › Bildirimler). Satır yoksa varsayılan geçerlidir.
model NotificationPref {
  userId    String   @map("user_id") @db.Uuid
  /// mesaj | arama | sure | odeme | kampanya | galeri
  konu      String
  /// uygulama | eposta | sms
  kanal     String
  acik      Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, konu, kanal])
  @@map("notification_prefs")
}

/// Teslim kaydı (Karar 48): her kanal gönderimi; zamanı gelince işçi gönderir. Sonuç güncellenir, kayıt silinmez.
model Delivery {
  id             String    @id @db.Uuid
  notificationId String?   @map("notification_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  /// Çalışana giden (yönetim bildirimi)
  staffId        String?   @map("staff_id") @db.Uuid
  /// push | eposta | sms
  kanal          String
  sablon         String
  sablonSurum    Int       @map("sablon_surum")
  ticari         Boolean   @default(false)
  /// bekliyor | gonderildi | atlandi | hata
  durum          String    @default("bekliyor")
  /// Atlama ya da hata nedeni (ör. bildirim okundu, adres engelli, sessiz saat)
  neden          String?
  /// okunmadiysa: uygulama içi bildirim okunduysa gönderilmez (kanal sırası, Karar 48)
  kosul          String?
  /// @pii Şablon değişkenleri (ad, talep, galeri, tutar)
  veri           Json      @default("{}")
  saglayici      String?
  saglayiciNo    String?   @map("saglayici_no")
  /// @pii Gösterim için maskeli hedef (a***@ornek.com, +90 5XX … 67)
  hedef          String?
  dueAt          DateTime  @default(now()) @map("due_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification? @relation(fields: [notificationId], references: [id])

  @@index([durum, dueAt])
  @@index([userId, createdAt])
  @@index([kanal, createdAt])
  @@map("deliveries")
}

/// Push cihaz anahtarı (FCM; Karar 48). Kapanan anahtar silinmez, `disabledAt` alır.
model PushToken {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// ios | android | web
  platform   String
  /// @pii Cihaz anahtarı
  token      String    @unique
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_tokens")
}

/// E-posta gönderim dışı listesi (Karar 50): kalıcı hata, 3 geçici hata, şikâyet ya da ticari iletiden ayrılma
model EmailSuppression {
  /// @pii Küçük harfli adres
  email          String   @id
  /// kalici_hata | gecici_hata | sikayet | ayrildi
  reason         String
  /// Geçici hata sayısı (3'te listeye alınır)
  count          Int      @default(1)
  /// Yalnızca ticari iletiyi mi durdurur (ayrılma, şikâyet) yoksa hepsini mi (kalıcı hata)
  onlyCommercial Boolean  @default(false) @map("only_commercial")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("email_suppressions")
}

/// Şablon sürümü (Karar 48): konsolda düzenlenen şablon yeni sürüm olarak eklenir; kod içindeki varsayılan sürüm 0
model NotificationTemplate {
  key       String
  version   Int
  icerik    Json
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([key, version])
  @@map("notification_templates")
}

/// E-posta doğrulama bağlantısı (tek kullanımlık, 24 saat)
model EmailChallenge {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// @pii
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("email_challenges")
}

/// Bildirim anahtarları (konsol): otomatik akışlar (`akis.<anahtar>`) ve ticari gönderim (`ticari`). Satır yoksa
/// varsayılan geçerlidir (akışta tanımlı; ticari açık).
model NotificationSwitch {
  key       String   @id
  enabled   Boolean
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("notification_switches")
}

/// Şikâyet (Karar 13.2, 53): kullanıcı, kural ya da ajan açar; öncelik nedenden, süre öncelikten gelir
model Report {
  id               String    @id @db.Uuid
  /// Konsolda görünen numara ("S-1024")
  no               Int       @unique @default(autoincrement())
  /// kullanici | kural | ajan
  source           String
  reporterUserId   String?   @map("reporter_user_id") @db.Uuid
  /// mesaj | talep | arac
  targetType       String    @map("target_type")
  targetId         String    @map("target_id") @db.Uuid
  /// Şikâyet edilen kişi ve (galeri adına yazdıysa) hesap
  targetUserId     String    @map("target_user_id") @db.Uuid
  targetAccountId  String?   @map("target_account_id") @db.Uuid
  reason           String
  /// kritik | yuksek | normal
  priority         String
  /// @pii Şikâyet edenin açıklaması
  note             String?
  /// Kuralın yakaladığı kelimeler ya da işaretler
  signals          String[]  @default([])
  dueAt            DateTime  @map("due_at") @db.Timestamptz(3)
  /// acik | kapali
  status           String    @default("acik")
  /// uyari | gizle | aski | engel | red
  decision         String?
  decisionNote     String?   @map("decision_note")
  decidedByStaffId String?   @map("decided_by_staff_id") @db.Uuid
  decidedByAgent   Boolean   @default(false) @map("decided_by_agent")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  /// Ajanın kendiliğinden yaptığı (mesajı gizledi, 24 saat askı); karar insana kalır
  agentAction      String?   @map("agent_action")
  /// Kalıcı engelleme önerisinin onay isteği
  approvalId       String?   @map("approval_id") @db.Uuid
  /// İtiraz kabul edildi, karar geri alındı
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  appeals   ReportAppeal[]
  sanctions UserSanction[]

  @@index([status, dueAt])
  @@index([targetUserId, createdAt])
  @@index([targetAccountId, decidedAt])
  @@index([reporterUserId, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// İtiraz (Karar 53): karardan sonra 7 gün; ilk kararı veren dışında bir moderatör inceler
model ReportAppeal {
  id               String    @id @db.Uuid
  reportId         String    @unique @map("report_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// @pii İtiraz metni
  text             String
  /// acik | kabul | red
  status           String    @default("acik")
  decidedByStaffId String?   @map("decided_by_staff_id") @db.Uuid
  decisionNote     String?   @map("decision_note")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id])

  @@index([status, createdAt])
  @@map("report_appeals")
}

/// Yaptırım: uyarı, 24 saat askı (mesaj gönderemez), kalıcı engelleme (hesap kapanır)
model UserSanction {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Galeri adına yazdıysa hesap da askıda sayılır
  accountId      String?   @map("account_id") @db.Uuid
  /// uyari | aski | engel
  kind           String
  reportId       String?   @map("report_id") @db.Uuid
  /// Askının bitişi; boşsa onay isteği (approvalId) sürdükçe geçerlidir
  until          DateTime? @db.Timestamptz(3)
  approvalId     String?   @map("approval_id") @db.Uuid
  createdByStaff String?   @map("created_by_staff") @db.Uuid
  byAgent        Boolean   @default(false) @map("by_agent")
  liftedAt       DateTime? @map("lifted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report? @relation(fields: [reportId], references: [id])

  @@index([userId, kind, createdAt])
  @@index([accountId, kind, createdAt])
  @@map("user_sanctions")
}

/// Yasaklı kelimeler (Karar 13.2): talep ve mesajlarda işaretlenir, moderasyona düşer
model BannedWord {
  word      String   @id
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("banned_words")
}

/// Otomatik içerik filtreleri: tel | kapora | link | kelime (satır yoksa açık)
model ContentFilter {
  key       String   @id
  enabled   Boolean
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("content_filters")
}

/// Çalışan notu (Karar 52): kullanıcı ya da galeri kartında; yalnızca çalışanlar görür
model StaffNote {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  /// @pii Not metni
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@map("staff_notes")
}

/// Kara liste (Karar 43): telefon, IBAN, IP. Değerin kendisi saklanmaz; anahtarlı özeti ve maskeli gösterimi tutulur
model Blocklist {
  id        String    @id @db.Uuid
  /// telefon | iban | ip | cihaz
  kind      String
  /// Anahtarlı özet (HMAC); aynı değer ikinci kez eklenmez
  valueHash String    @map("value_hash")
  /// @pii Maskeli gösterim (05•• ••• •• 41, TR•• … 4410)
  masked    String
  note      String?
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy String?   @map("removed_by") @db.Uuid

  @@index([kind, valueHash])
  @@map("blocklist")
}

/// Destek talebi (Karar 54): uygulama içi sohbet ve e-posta tek kuyrukta
model SupportTicket {
  id              String    @id @db.Uuid
  /// Görünen numara ("D-20931")
  no              Int       @unique @default(autoincrement())
  /// Girişli kullanıcı; e-postayla gelen ve eşleşmeyen talepte boş
  userId          String?   @map("user_id") @db.Uuid
  /// @pii E-postayla gelen talebin adresi (kullanıcıyla eşleşmediyse)
  email           String?
  /// uygulama | eposta
  channel         String
  /// odeme | talep | dolandiricilik | hesap | diger
  topic           String
  /// Talep ya da ödeme no (kullanıcının yazdığı)
  reference       String?
  /// @pii Konu satırı (e-postada) ya da ilk mesajın başı
  subject         String
  /// acik | yanitlandi | cozuldu
  status          String    @default("acik")
  /// Ödeme ve hesap güvenliği öne alınır
  priority        Boolean   @default(false)
  dueAt           DateTime  @map("due_at") @db.Timestamptz(3)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  /// 1–5, çözümden sonra
  rating          Int?
  ratingAskedAt   DateTime? @map("rating_asked_at") @db.Timestamptz(3)
  lastMessageAt   DateTime  @map("last_message_at") @db.Timestamptz(3)
  /// Kullanıcının son okuduğu
  userReadAt      DateTime? @map("user_read_at") @db.Timestamptz(3)
  /// İmha edildiyse zamanı (Karar 59): metinler silinir, satır kalır
  /// Rengarenk Ajanı (Karar 41): yanıt taslağı (@pii, şifreli), güven (0–100), sınıf notu; güven eşiği aşıldıysa ajan
  /// yanıtlayıp çözer (agentAnsweredAt)
  /// @pii
  agentDraft      String?   @map("agent_draft")
  agentConfidence Int?      @map("agent_confidence")
  agentNote       String?   @map("agent_note")
  agentAnsweredAt DateTime? @map("agent_answered_at") @db.Timestamptz(3)
  purgedAt        DateTime? @map("purged_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  messages SupportMessage[]

  @@index([status, dueAt])
  @@index([userId, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  /// kullanici | destek
  side      String
  staffId   String?  @map("staff_id") @db.Uuid
  /// @pii Şifreli metin (AES-256-GCM, mesajlarla aynı anahtar)
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Kendi verini indir (Karar 58): SMS koduyla istenir, işçi hazırlar, bağlantı 7 gün geçerli
model DataExport {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// hazirlaniyor | hazir | hata | suresi_doldu
  status       String    @default("hazirlaniyor")
  /// Depolamadaki dosya anahtarı
  storageKey   String?   @map("storage_key")
  sizeBytes    Int?      @map("size_bytes")
  readyAt      DateTime? @map("ready_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  downloadedAt DateTime? @map("downloaded_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("data_exports")
}

/// KVKK m.11 başvurusu (Karar 58): en geç 30 gün içinde yanıt; ajan taslak hazırlar, yanıtı çalışan gönderir
model KvkkRequest {
  id             String    @id @db.Uuid
  /// Görünen numara ("K-1001")
  no             Int       @unique @default(autoincrement())
  userId         String?   @map("user_id") @db.Uuid
  /// @pii Dışarıdan gelen başvuruda başvuranın adı
  applicantName  String?   @map("applicant_name")
  /// @pii Dışarıdan gelen başvuruda yanıt adresi
  applicantEmail String?   @map("applicant_email")
  /// bilgi | duzeltme | silme | itiraz
  kind           String
  /// @pii Başvuru metni
  text           String
  /// hesap_kodu | kimlik
  verification   String
  /// uygulama | eposta | posta
  channel        String
  /// acik | yanitlandi
  status         String    @default("acik")
  dueAt          DateTime  @map("due_at") @db.Timestamptz(3)
  /// @pii Gönderilen yanıt
  response       String?
  respondedBy    String?   @map("responded_by") @db.Uuid
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  /// İmha edildiyse zamanı (Karar 59): metinler silinir, satır kalır
  purgedAt       DateTime? @map("purged_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, dueAt])
  @@index([userId, createdAt])
  @@map("kvkk_requests")
}

/// Kapatılan hesap (Karar 31, 59). Kişisel veri `users` satırında anonimleşir; kimlik ve telefon doğrulama kaydı
/// MKTTY m.22 gereği 5 yıl şifreli burada kalır, yalnızca resmi talep ve imha sürecinde açılır. Mesajlar 1 yıl sonra
/// imha listesine girer. İade önerileri onay kuyruğundadır (`iadeler`), para iadesi burada yapılmaz.
model AccountClosure {
  id                String    @id @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  /// buldum | cok_mesaj | baska_platform | diger
  reason            String?
  /// @pii Doğrulanmış telefon, AES-256-GCM ile şifreli
  phoneEnc          String?   @map("phone_enc")
  /// Telefonun anahtarlı özeti (kara liste ve resmi talepte arama)
  phoneHash         String    @map("phone_hash")
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  /// Önerilen iade toplamı (kuruş) ve onay istekleri: [{ siparis, onayId, kurus }]
  refundKurus       BigInt    @default(0) @map("refund_kurus")
  refunds           Json      @default("[]")
  /// Kimlik kaydının imha tarihi (5 yıl) ve mesajların imha tarihi (1 yıl)
  keepIdentityUntil DateTime  @map("keep_identity_until") @db.Timestamptz(3)
  purgeMessagesAt   DateTime  @map("purge_messages_at") @db.Timestamptz(3)
  /// Kimlik kaydı imha edildiyse zamanı (şifreli telefon silinir)
  identityPurgedAt  DateTime? @map("identity_purged_at") @db.Timestamptz(3)
  messagesPurgedAt  DateTime? @map("messages_purged_at") @db.Timestamptz(3)
  closedAt          DateTime  @default(now()) @map("closed_at") @db.Timestamptz(3)

  @@index([phoneHash])
  @@index([keepIdentityUntil])
  @@index([purgeMessagesAt])
  @@map("account_closures")
}

/// Periyodik imha dönemi (Karar 59): ajan süresi dolan kayıtları sayar, Sahip listeyi onaylar, işçi dönem gününde
/// (1 Ocak ve 1 Temmuz, 03.00) imha eder ve tutanağı yazar. Satırlar silinmez.
model DisposalRun {
  id             String    @id @db.Uuid
  /// Tutanak numarası: İ-2027-01
  no             String    @unique
  scheduledFor   DateTime  @map("scheduled_for") @db.Timestamptz(3)
  /// liste | onaylandi | calisti
  status         String    @default("liste")
  /// Ajanın son sayımı: { sohbet: 12, hesap: 3, ... }
  counts         Json      @default("{}")
  countedAt      DateTime? @map("counted_at") @db.Timestamptz(3)
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  /// Onay anındaki liste (tutanağa girer)
  approvedCounts Json?     @map("approved_counts")
  ranAt          DateTime? @map("ran_at") @db.Timestamptz(3)
  /// İmha tutanağı: kalem başına imha edilen ve bekletilen sayı, yöntem
  report         Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, scheduledFor])
  @@map("disposal_runs")
}

/// Veri ihlali ya da tatbikatı (Karar 59): öğrenildiği andan 72 saat içinde Kurul'a bildirim. Satırlar silinmez.
model BreachIncident {
  id        String    @id @db.Uuid
  no        Int       @unique @default(autoincrement())
  drill     Boolean
  /// Ne oldu (kısa); kişisel veri yazılmaz
  summary   String
  learnedAt DateTime  @map("learned_at") @db.Timestamptz(3)
  deadline  DateTime  @db.Timestamptz(3)
  /// Tamamlanan adımlar: { durdur: { zaman, calisan, not } }
  steps     Json      @default("{}")
  openedBy  String    @map("opened_by") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy  String?   @map("closed_by") @db.Uuid
  report    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([closedAt])
  @@map("breach_incidents")
}

/// Resmi makam talebi (mahkeme, savcılık, kolluk; Karar 59): yalnız sahip ve yönetici görür, verilen her veri kaydedilir.
/// İlgili kişinin verisi talep sürdükçe imhada bekletilir. Satırlar silinmez.
model OfficialRequest {
  id           String    @id @db.Uuid
  no           Int       @unique @default(autoincrement())
  authority    String
  /// @pii Talep konusu (kişi adı geçebilir)
  subject      String
  userId       String?   @map("user_id") @db.Uuid
  accountId    String?   @map("account_id") @db.Uuid
  /// Talep yazısı kullanıcıya bildirimi yasaklıyor
  noNotify     Boolean   @default(false) @map("no_notify")
  /// belge_bekleniyor | inceleniyor | yanitlandi | reddedildi
  status       String    @default("belge_bekleniyor")
  /// Resmi yazı (depolamada)
  documentKey  String?   @map("document_key")
  documentType String?   @map("document_type")
  /// Verilen veriler: [{ ne, zaman, calisan }]
  given        Json      @default("[]")
  note         String?
  createdBy    String    @map("created_by") @db.Uuid
  respondedBy  String?   @map("responded_by") @db.Uuid
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([accountId])
  @@index([status, createdAt])
  @@map("official_requests")
}

// ── Rengarenk Ajanı ve yapay zekâ (Karar 41, 57) ──────────────

/// Yapay zekâ ayarı (tek satır, id = 1): aylık sınır yalnızca Sahip değiştirir, değişiklik işlem kaydına girer
model AiSetting {
  id         Int      @id @default(1)
  limitUsd   Int      @default(150) @map("limit_usd")
  /// %80 uyarısının gönderildiği ay (2026-11); ayda bir kez
  alertMonth String?  @map("alert_month")
  /// Sınıra ulaşıldı bildiriminin gönderildiği ay
  capMonth   String?  @map("cap_month")
  updatedBy  String?  @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_settings")
}

/// Görev başına aç/kapat (Karar 57); satırı olmayan görev açıktır
model AiTaskSwitch {
  task      String   @id
  enabled   Boolean
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_task_switches")
}

/// Her yapay zekâ çağrısı: görev, istem sürümü, token ve maliyet. İçerik maskelidir (Teknik tasarım §10).
model AiCall {
  id            String   @id @db.Uuid
  task          String
  promptVersion String   @map("prompt_version")
  provider      String
  model         String
  /// tamam | kapali | butce | hata
  status        String
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  /// Milyonda bir USD
  costMicroUsd  Int      @default(0) @map("cost_micro_usd")
  /// Maskelenmiş istek ve yanıt (kırpılmış)
  inputMasked   String?  @map("input_masked")
  outputMasked  String?  @map("output_masked")
  /// Tür başına maskelenen değer sayısı
  masked        Json     @default("{}")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([task, createdAt])
  @@map("ai_calls")
}

/// Ajanın kendi yaptığı işlemler (Karar 41): konsolda "Bugün yaptıkları", tek tıkla geri alma, haftalık karne
model AgentAction {
  id         String    @id @db.Uuid
  kind       String
  title      String
  reason     String
  /// "Güven %97" | "Kural" | "Kontroller tam" | "Rapor"
  confidence String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  /// Geri alma için gereken bilgi (türüne göre)
  undo       Json?
  undoneAt   DateTime? @map("undone_at") @db.Timestamptz(3)
  undoneBy   String?   @map("undone_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("agent_actions")
}

/// Ajanın önerileri (Karar 41, önerir ve onay bekler): kurallar her gün üretir, aynı öneri aynı anahtarla bir kez açılır
model AgentSuggestion {
  id        String    @id @db.Uuid
  kind      String
  /// Tekrarı önler: deneme-bitiyor:2026-11-09
  key       String    @unique
  title     String
  reason    String
  data      Json      @default("{}")
  /// acik | kapandi
  status    String    @default("acik")
  closedBy  String?   @map("closed_by") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("agent_suggestions")
}

/// Çalışan uyarıları (Karar 40, 41, 57, 58, 59): alıcı başına bir satır. Metin kişisel veri taşımaz (e-posta şirket
/// hesabına gider); ayrıntı konsolda yetkiyle açılır. Aynı uyarı aynı anahtarla bir kez açılır.
model StaffAlert {
  id          String    @id @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  /// STAFF_ALERT_RULES anahtarı
  rule        String
  /// Tekrarı önleyen anahtar (ör. "yeni_cihaz:<cihaz>", "kvkk_sure:<başvuru>")
  dedupeKey   String    @map("dedupe_key")
  critical    Boolean   @default(false)
  title       String
  body        String
  /// Konsoldaki ekran
  link        String
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  /// bekliyor | gonderildi | hata | yok (adres yok ya da kanal kapalı)
  emailStatus String    @default("bekliyor") @map("email_status")
  emailTries  Int       @default(0) @map("email_tries")
  emailedAt   DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([staffId, dedupeKey])
  @@index([staffId, createdAt])
  @@index([emailStatus, createdAt])
  @@map("staff_alerts")
}

/// Kritik olmayan uyarı kuralını kapatma (Sahip); satır yoksa kural açıktır
model StaffAlertSetting {
  rule      String   @id
  enabled   Boolean
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("staff_alert_settings")
}
