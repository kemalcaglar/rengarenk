// Rengarenk veri modeli · Sprint 1 kapsamı
// Kişisel veri içeren alanlar `/// @pii` ile etiketlenir (Teknik tasarım §4). Maskeleme,
// veri kopyası, anonimleştirme ve imha bu etiketlerden çalışır.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Kimlik ve hesap ────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountKind {
  INDIVIDUAL
  BUSINESS
}

enum BusinessKind {
  DEALER
  RENTAL
  BOAT
  AIRCRAFT
}

enum AccountStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  MANAGER
  SALES
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model User {
  id              String     @id @db.Uuid
  /// @pii E.164 biçiminde, ör. +905321234567
  phone           String     @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// @pii
  displayName     String?    @map("display_name")
  /// @pii
  email           String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   AccountMember[]
  devices       Device[]
  sessions      Session[]
  featureTester FeatureTester?

  @@map("users")
}

model Account {
  id           String        @id @db.Uuid
  kind         AccountKind
  name         String
  businessKind BusinessKind? @map("business_kind")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  members AccountMember[]
  ledger  EntitlementLedger[]

  @@map("accounts")
}

model AccountMember {
  accountId String     @map("account_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
  @@map("account_members")
}

model Device {
  id         String         @id @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  /// @pii
  pushToken  String?        @map("push_token")
  trusted    Boolean        @default(false)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("devices")
}

/// Yenileme jetonu 90 gün geçerlidir (T09). Jetonun kendisi değil, SHA-256 özeti saklanır.
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

model OtpChallenge {
  id         String    @id @db.Uuid
  /// @pii
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// @pii
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// ── Yönetim ekibi ve yetkiler (Karar 40, T10) ────────────────

/// Hazır roller `packages/shared/src/staff.ts` içindeki matristen yetki alır.
/// CATALOG eski değerdir, atanamaz (kontrol kısıtı). CUSTOM: yetkileri `staff_roles` tablosundan gelir.
enum StaffRole {
  OWNER
  ADMIN
  MODERATOR
  SUPPORT
  CATALOG
  FINANCE
  AGENT
  OPERATIONS
  MARKETING
  VIEWER
  CUSTOM
}

enum StaffStatus {
  ACTIVE
  DISABLED
  INVITED
}

model StaffMember {
  id               String      @id @db.Uuid
  /// @pii Google Workspace şirket e-postası
  email            String      @unique
  /// @pii
  name             String
  role             StaffRole
  customRoleId     String?     @map("custom_role_id") @db.Uuid
  status           StaffStatus @default(ACTIVE)
  /// Doğrulama uygulaması kurulup ilk kodla onaylandıysa true
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  /// Doğrulama uygulaması sırrı, AES-256-GCM ile şifreli (anahtar STAFF_SECRET_KEY)
  totpSecretEnc    String?     @map("totp_secret_enc")
  /// Son kabul edilen kodun zaman adımı; aynı kod ikinci kez kullanılamaz
  totpLastStep     BigInt?     @map("totp_last_step")
  /// Google hesabının değişmez kimliği; ilk girişte bağlanır
  googleSub        String?     @unique @map("google_sub")
  invitedBy        String?     @map("invited_by") @db.Uuid
  inviteExpiresAt  DateTime?   @map("invite_expires_at") @db.Timestamptz(3)
  lastLoginAt      DateTime?   @map("last_login_at") @db.Timestamptz(3)
  disabledAt       DateTime?   @map("disabled_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  customRole         StaffCustomRole?    @relation(fields: [customRoleId], references: [id])
  requestedApprovals Approval[]          @relation("ApprovalRequester")
  decidedApprovals   Approval[]          @relation("ApprovalDecider")
  sessions           StaffSession[]
  devices            StaffDevice[]
  recoveryCodes      StaffRecoveryCode[]

  @@map("staff_members")
}

/// Sahibin yetkileri tek tek işaretleyerek oluşturduğu rol. permissions: { "rapor.gor": "tam", ... }
model StaffCustomRole {
  id          String   @id @db.Uuid
  name        String   @unique
  permissions Json
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members StaffMember[]

  @@map("staff_roles")
}

/// Yönetim girişinin ara adımı: Google yönlendirmesi (state, nonce, PKCE), ardından iki adımlı doğrulama.
/// `ticketHash` yalnızca Google adımı geçince dolar; iki adımlı doğrulama bu biletle yapılır.
model StaffLoginChallenge {
  id             String    @id @db.Uuid
  stateHash      String    @unique @map("state_hash")
  nonce          String
  codeVerifier   String    @map("code_verifier")
  staffId        String?   @map("staff_id") @db.Uuid
  googleSub      String?   @map("google_sub")
  ticketHash     String?   @unique @map("ticket_hash")
  /// Kurulum sırasında üretilen, henüz onaylanmamış sır (şifreli)
  pendingTotpEnc String?   @map("pending_totp_enc")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  googleAt       DateTime? @map("google_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// @pii
  ip             String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("staff_login_challenges")
}

/// Yönetim oturumu: jetonun SHA-256 özeti saklanır. 30 dk hareketsizlikte ve en geç 12 saatte kapanır.
model StaffSession {
  id           String    @id @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  deviceId     String?   @map("device_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// @pii
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff  StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  device StaffDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@map("staff_sessions")
}

/// Çalışanın giriş yaptığı tarayıcılar. Yeni cihazdan girişte sahibe bildirim gider (Karar 40).
model StaffDevice {
  id          String   @id @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  /// @pii
  userAgent   String?  @map("user_agent")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  staff    StaffMember    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  sessions StaffSession[]

  @@unique([staffId, deviceHash])
  @@map("staff_devices")
}

/// Doğrulama uygulamasına erişilemezse kullanılan tek kullanımlık kurtarma kodları (özetleri).
model StaffRecoveryCode {
  id       String    @id @db.Uuid
  staffId  String    @map("staff_id") @db.Uuid
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_recovery_codes")
}

enum ActorType {
  USER
  STAFF
  AGENT
  SYSTEM
}

/// Yalnızca ekleme yapılır; güncelleme ve silme veritabanı tetikleyicisiyle engellenir. 2 yıl saklanır.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  /// @pii
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ── Olaylar ───────────────────────────────────────────────────

/// Her işlem kendi olayını aynı veritabanı işleminde buraya yazar; aktarıcı kuyruğa iletir.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  payload     Json
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("outbox")
}

// ── Haklar ────────────────────────────────────────────────────

/// Hak defteri: yalnızca ekleme. Bakiye defterden hesaplanır.
/// (source_type, source_id, kind) tekil: aynı olay iki kez işlenmez.
model EntitlementLedger {
  id         BigInt   @id @default(autoincrement())
  accountId  String   @map("account_id") @db.Uuid
  /// talep, ilk_mesaj, uzatma, ust_sira, acil, vitrin
  kind       String
  /// artı: satın alma veya tanımlama, eksi: kullanım veya iade
  delta      Int
  /// satin_alma, paket, tanimlama, kullanim, iade, sure_dolumu
  reason     String
  /// order, staff_grant, package_cycle, message, refund
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  /// kullanıcı, çalışan veya ajan
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@unique([sourceType, sourceId, kind])
  @@index([accountId, kind])
  @@map("entitlement_ledger")
}

// ── Onaylar (dört göz) ve iade kilidi ─────────────────────────

/// Onay motoru türleri; kurallar `packages/shared/src/staff.ts` (APPROVAL_POLICIES). STAFF_ROLE kullanılmıyor.
enum ApprovalKind {
  REFUND
  PRICE_CHANGE
  STAFF_ROLE
  BULK_SEND
  COUPON
  PERMANENT_BAN
  ACCOUNT_DELETE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// Karara bağlanan onay değiştirilemez (rr_approval_immutable). Yürütme sonucu `approval_results` tablosundadır.
model Approval {
  id           String         @id @db.Uuid
  kind         ApprovalKind
  status       ApprovalStatus @default(PENDING)
  subjectType  String         @map("subject_type")
  subjectId    String         @map("subject_id")
  /// Kuruş cinsinden tutar (iadelerde zorunlu)
  amountKurus  BigInt?        @map("amount_kurus")
  payload      Json           @default("{}")
  /// Kuyrukta görünen kısa başlık
  title        String         @default("")
  /// İsteyenin gerekçesi
  reason       String?
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote String?        @map("decision_note")
  /// Bu tarihe kadar karar verilmezse istek düşer
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  requester StaffMember      @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  decider   StaffMember?     @relation("ApprovalDecider", fields: [decidedBy], references: [id])
  refunds   Refund[]
  results   ApprovalResult[]

  @@index([kind, status])
  @@index([status, expiresAt])
  @@map("approvals")
}

enum ApprovalOutcome {
  SUCCEEDED
  FAILED
}

/// Onaylanan işlemin yürütme denemeleri. Yalnızca ekleme; son satır güncel sonuçtur.
model ApprovalResult {
  id         BigInt          @id @default(autoincrement())
  approvalId String          @map("approval_id") @db.Uuid
  outcome    ApprovalOutcome
  detail     Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  approval Approval @relation(fields: [approvalId], references: [id])

  @@index([approvalId])
  @@map("approval_results")
}

enum RefundStatus {
  PENDING_EXECUTION
  EXECUTED
  FAILED
}

/// "Bana sorulmadan sistemde hiçbir zaman iade yapılmasın." Kilit 1: veritabanı tetikleyicisi
/// her iade kaydının Sahip rolündeki bir çalışanın 72 saatten eski olmayan onayına bağlı olduğunu
/// ve tutarın onaydakiyle aynı olduğunu denetler (migration.sql).
model Refund {
  id          String       @id @db.Uuid
  paymentId   String       @map("payment_id")
  amountKurus BigInt       @map("amount_kurus")
  approvalId  String       @map("approval_id") @db.Uuid
  status      RefundStatus @default(PENDING_EXECUTION)
  executedAt  DateTime?    @map("executed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  approval Approval @relation(fields: [approvalId], references: [id])

  @@index([approvalId])
  @@map("refunds")
}

// ── Ayarlar: özellik anahtarları ve bakım (T13, Karar 47) ─────

enum FlagAudience {
  ALL
  BUSINESS
  TESTERS
}

/// Anahtar listesi kodda (`packages/shared/src/flags.ts`); satırı olmayan anahtar kapalıdır.
/// Bakım alanları `bakim.tum`, `bakim.odeme` … anahtarlarıyla burada durur; `note` kullanıcıya gösterilen duyurudur.
model FeatureFlag {
  key       String           @id
  enabled   Boolean          @default(false)
  audience  FlagAudience     @default(ALL)
  /// Kitlenin yüzde kaçına açık (kullanıcı kimliğinden hesaplanan sabit dilim)
  percent   Int              @default(100)
  /// Boş: tüm platformlar
  platforms DevicePlatform[] @default([])
  note      String?
  updatedBy String?          @map("updated_by") @db.Uuid
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

/// Yeni özellikleri önce deneyen kullanıcılar (çalışanların kendi kullanıcı hesapları; Teknik tasarım §15).
model FeatureTester {
  userId    String   @id @map("user_id") @db.Uuid
  addedBy   String   @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feature_testers")
}
