# Caddy TLS sertifikalarını otomatik alır ve yeniler. WEB_HOSTS compose.prod.yml'den gelir (kapalı test ortamında
# beta.rengarenksite.com; kök alan adı canlıya geçene kadar tanıtım sayfasında).
{$WEB_HOSTS} {
  reverse_proxy web:3000
}

api.rengarenksite.com {
  reverse_proxy api:4000
}

yonetim.rengarenksite.com {
  # Yalnızca şirket ağından ve VPN'den erişim (IP listesi canlı kurulumda doldurulacak)
  reverse_proxy admin:3000
}
