# Bu dosyanın gerçeği depoda SOPS ile şifreli tutulur (deploy/secrets.prod.enc.env) ve yalnızca sunucuda açılır.
NODE_ENV=production
DATABASE_URL=postgresql://rengarenk:CHANGE_ME@db.internal:5432/rengarenk
REDIS_URL=redis://redis:6379
OPENSEARCH_URL=http://opensearch:9200
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=rengarenk
JWT_SECRET=CHANGE_ME_EN_AZ_32_KARAKTER
SMS_PROVIDER=iletimerkezi
SMS_FALLBACK_PROVIDER=
SMS_SENDER_ID=RENGARENK
ILETIMERKEZI_KEY=CHANGE_ME
ILETIMERKEZI_HASH=CHANGE_ME
# Telefon doğrulama kodu (Karar 18): yalnızca üyelikte, numara değiştirirken ve hassas işlem onayında. Kanallar
# sırayla denenir; WhatsApp için Meta İşletme hesabı, numara ve onaylı kimlik doğrulama şablonu gerekir.
VERIFY_CHANNELS=sms
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=rengarenk_kod
WHATSAPP_TEMPLATE_LANG=tr
LOG_LEVEL=info
METRICS_TOKEN=CHANGE_ME
SENTRY_DSN=
API_URL=http://api:4000
WEB_ORIGIN=https://rengarenksite.com
ADMIN_ORIGIN=https://yonetim.rengarenksite.com
NEXT_PUBLIC_API_URL=https://api.rengarenksite.com
# Yönetim girişi (T10): Google Cloud Console > OAuth istemcisi (Web). Yetkili yönlendirme adresi:
# https://yonetim.rengarenksite.com/api/oturum/google/donus
STAFF_AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
STAFF_EMAIL_DOMAINS=rengarenksite.com
# Üye girişi (Karar 18): Google ile giriş, yönetim girişinden ayrı OAuth istemcisi (Web). Yetkili yönlendirme adresi:
# https://rengarenksite.com/api/oturum/google/donus (test ortamında https://beta.rengarenksite.com/...).
# İstemci açılana kadar none (Google düğmesi "şu an kapalı" der); canlıda fake kullanılamaz.
USER_AUTH_PROVIDER=none
USER_GOOGLE_CLIENT_ID=
USER_GOOGLE_CLIENT_SECRET=
# iPhone'da Apple ile giriş: Apple geliştirici hesabı açılınca apple
APPLE_AUTH_PROVIDER=none
APPLE_CLIENT_IDS=tr.com.rengarenk.app
# Doğrulama uygulaması sırlarını şifreler; en az 32 karakter. Değişirse herkes 2FA'yı yeniden kurar.
STAFF_SECRET_KEY=CHANGE_ME_EN_AZ_32_KARAKTER
# Mesaj gövdeleri (AES-256-GCM); değiştirilirse eski mesajlar açılamaz
MESSAGE_SECRET_KEY=CHANGE_ME_EN_AZ_32_KARAKTER
# Katalog paketi imza anahtarları: node dist/cli/katalog-anahtar.js ile üretilir (Teknik tasarım §5)
CATALOG_SIGNING_KEY=CHANGE_ME
CATALOG_VERIFY_KEY=CHANGE_ME

# Web ödemesi (PayTR iFrame API). Sözleşme gelene kadar none: satın alma kapalı
PAYMENT_PROVIDER=none
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
# e-Arşiv entegratörü gelene kadar none: faturalar kuyrukta bekler
EARSIV_PROVIDER=none
# Reklam ölçümü (Karar 35): hesaplar açılınca META_PROVIDER=capi ve aşağıdakiler
META_PROVIDER=none
META_PIXEL_ID=
META_CAPI_TOKEN=
META_AD_ACCOUNT=
GOOGLE_ADS_PROVIDER=none
# Mağaza ödemeleri (App Store, Google Play; RevenueCat). Hesaplar açılana kadar none: uygulamada satın alma kapalı
STORE_PROVIDER=none
# Bildirimler (Karar 48, 50): Amazon SES (Frankfurt) SMTP ile; işlemsel ve ticari ayrı gönderen. SES alan adı
# doğrulanıp üretim erişimi gelene kadar none (e-posta kapalı). SMTP kimliği SES konsolundan, ayrı IAM kullanıcısıyla.
EMAIL_PROVIDER=none
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EPOSTA_GONDEREN=Rengarenk <bildirim@bildirim.rengarenksite.com>
EPOSTA_GONDEREN_TICARI=Rengarenk <bulten@bulten.rengarenksite.com>
# SES yapılandırma kümeleri: işlemsel ve ticari ayrı itibar ölçümü (Karar 50)
SES_YAPILANDIRMA_ISLEMSEL=rengarenk-islemsel
SES_YAPILANDIRMA_TICARI=rengarenk-ticari
# Ticari e-posta IP ısınmasının başladığı gün (YYYY-AA-GG); boşken ticari e-posta gönderilmez (Karar 50)
EPOSTA_ISINMA_BASLANGIC=
# E-posta sunucusunun geri bildirim (bounce, şikâyet) imzası
EPOSTA_WEBHOOK_SECRET=
# İYS hesabı açılana kadar none: ticari onaylar rıza kaydında bekler
IYS_PROVIDER=none
# Push: Firebase projesi açılınca fcm ve hizmet hesabı JSON'u (base64)
PUSH_PROVIDER=none
# Yapay zekâ (T11, Karar 57): AWS Bedrock (Amazon Nova, eu-central-1). Anahtar yalnızca bedrock:InvokeModel yetkili
# rengarenk-bedrock IAM kullanıcısının; KVKK standart sözleşmesi bildirilene kadar none
AI_PROVIDER=none
BEDROCK_REGION=eu-central-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
FCM_SERVICE_ACCOUNT=
# RevenueCat › Integrations › Webhooks › Authorization header değeri (en az 24 karakter, rastgele)
REVENUECAT_WEBHOOK_AUTH=
API_PUBLIC_URL=https://api.rengarenksite.com
