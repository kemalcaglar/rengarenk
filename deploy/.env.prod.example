# Bu dosyanın gerçeği depoda SOPS ile şifreli tutulur (deploy/secrets.prod.enc.env) ve yalnızca sunucuda açılır.
NODE_ENV=production
DATABASE_URL=postgresql://rengarenk:CHANGE_ME@db.internal:5432/rengarenk
REDIS_URL=redis://redis:6379
OPENSEARCH_URL=http://opensearch:9200
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=rengarenk
JWT_SECRET=CHANGE_ME_EN_AZ_32_KARAKTER
SMS_PROVIDER=iletimerkezi
SMS_FALLBACK_PROVIDER=
SMS_SENDER_ID=RENGARENK
ILETIMERKEZI_KEY=CHANGE_ME
ILETIMERKEZI_HASH=CHANGE_ME
LOG_LEVEL=info
METRICS_TOKEN=CHANGE_ME
SENTRY_DSN=
API_URL=http://api:4000
WEB_ORIGIN=https://rengarenk.com.tr
ADMIN_ORIGIN=https://yonetim.rengarenk.com.tr
NEXT_PUBLIC_API_URL=https://api.rengarenk.com.tr
# Yönetim girişi (T10): Google Cloud Console > OAuth istemcisi (Web). Yetkili yönlendirme adresi:
# https://yonetim.rengarenk.com.tr/api/oturum/google/donus
STAFF_AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
STAFF_EMAIL_DOMAINS=rengarenk.com.tr
# Doğrulama uygulaması sırlarını şifreler; en az 32 karakter. Değişirse herkes 2FA'yı yeniden kurar.
STAFF_SECRET_KEY=CHANGE_ME_EN_AZ_32_KARAKTER
# Mesaj gövdeleri (AES-256-GCM); değiştirilirse eski mesajlar açılamaz
MESSAGE_SECRET_KEY=CHANGE_ME_EN_AZ_32_KARAKTER
# Katalog paketi imza anahtarları: node dist/cli/katalog-anahtar.js ile üretilir (Teknik tasarım §5)
CATALOG_SIGNING_KEY=CHANGE_ME
CATALOG_VERIFY_KEY=CHANGE_ME

# Web ödemesi (PayTR iFrame API). Sözleşme gelene kadar none: satın alma kapalı
PAYMENT_PROVIDER=none
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0
# e-Arşiv entegratörü gelene kadar none: faturalar kuyrukta bekler
EARSIV_PROVIDER=none
# Mağaza ödemeleri (App Store, Google Play; RevenueCat). Hesaplar açılana kadar none: uygulamada satın alma kapalı
STORE_PROVIDER=none
# Bildirimler (Karar 48, 50): kendi SMTP sunucumuz (Postal/Postfix), işlemsel ve ticari ayrı gönderen ve IP
EMAIL_PROVIDER=smtp
SMTP_HOST=posta.rengarenk.com.tr
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EPOSTA_GONDEREN=Rengarenk <bildirim@bildirim.rengarenk.com.tr>
EPOSTA_GONDEREN_TICARI=Rengarenk <bulten@bulten.rengarenk.com.tr>
# Ticari e-posta IP ısınmasının başladığı gün (YYYY-AA-GG); boşken ticari e-posta gönderilmez (Karar 50)
EPOSTA_ISINMA_BASLANGIC=
# E-posta sunucusunun geri bildirim (bounce, şikâyet) imzası
EPOSTA_WEBHOOK_SECRET=
# İYS hesabı açılana kadar none: ticari onaylar rıza kaydında bekler
IYS_PROVIDER=none
# Push: Firebase projesi açılınca fcm ve hizmet hesabı JSON'u (base64)
PUSH_PROVIDER=none
# Yapay zekâ (T11): Vertex AI hesabı açılınca vertex + VERTEX_SERVICE_ACCOUNT (base64 JSON); o zamana kadar none
AI_PROVIDER=none
VERTEX_SERVICE_ACCOUNT=
VERTEX_LOCATION=europe-west4
FCM_SERVICE_ACCOUNT=
# RevenueCat › Integrations › Webhooks › Authorization header değeri (en az 24 karakter, rastgele)
REVENUECAT_WEBHOOK_AUTH=
API_PUBLIC_URL=https://api.rengarenk.com.tr
