# İade yürütücü ortam dosyası (yalnızca iade-yurutucu kapsayıcısı okur; Teknik tasarım §7, kilit 2).
# Sunucuda /srv/rengarenk/.env.iade olarak, SOPS ile şifreli tutulur. API ve işçi bu dosyayı okumaz.
# PayTR iadeyi ödemeyle aynı mağaza bilgileriyle imzalar; bu yüzden ek olarak PayTR'den iade API'sinin yalnızca
# iade yürütücünün IP adresine açılması istenmeli.
REFUND_PROVIDER=none
IADE_PAYTR_MERCHANT_ID=
IADE_PAYTR_MERCHANT_KEY=
IADE_PAYTR_MERCHANT_SALT=
